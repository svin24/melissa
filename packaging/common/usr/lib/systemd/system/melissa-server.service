[Unit]
Description=Melissa server (web UI and lead agent)
After=network-online.target
Wants=network-online.target
# Deliberately not ordered after k3s or melissa-kubeconfig.service: the web UI and agents start
# at once. The server reads /run/melissa-kube/server.kubeconfig on each cluster call, so it attaches
# to k3s when the credentials appear (and follows rotations) without a restart.

[Service]
# A fixed system user (sysusers.d/melissa.conf), not DynamicUser: the agent CLIs and their
# logins live in its home, /var/lib/melissa/home, set up with `sudo melissa-setup agent <name>`.
# Each agent still runs in its own bubblewrap sandbox with only its own credential file.
User=melissa
Group=melissa
StateDirectory=melissa
StateDirectoryMode=0750
ConfigurationDirectory=melissa
# Owned by melissa via tmpfiles.d/melissa-config.conf (Settings writes providers.toml here).
ConfigurationDirectoryMode=0750
# Per-sandbox egress sockets (crates/agent/src/egress) live in /run/melissa/egress.
RuntimeDirectory=melissa
RuntimeDirectoryMode=0700
# Maps the XDG paths used by the server to /etc/melissa, /var/lib/melissa and /run/melissa.
Environment=XDG_CONFIG_HOME=/etc XDG_STATE_HOME=/var/lib XDG_DATA_HOME=/var/lib XDG_RUNTIME_DIR=/run
# Where the vendors' installers put the agent CLIs (found on PATH as claude, grok, opencode).
Environment=HOME=/var/lib/melissa/home
Environment=PATH=/var/lib/melissa/home/.local/bin:/var/lib/melissa/home/.grok/bin:/var/lib/melissa/home/.opencode/bin:/usr/bin
# Read access to the read-only k3s kubeconfig (root:melissa-kube 0640 in /run/melissa-kube).
SupplementaryGroups=melissa-kube
ExecStart=/usr/bin/melissa-server
# Resource limits per agent sandbox (crates/agent/src/sandbox/limits.rs): the service's cgroup is
# handed to the melissa user; the server moves itself into server/ and gives each sandbox its own
# child of sandboxes/ with memory, process and CPU limits. Without this, agents run unlimited.
Delegate=memory pids cpu io
Restart=on-failure
# No NoNewPrivileges=: each agent sandbox runs as its own host user from melissa's subordinate ids
# (/etc/subuid, crates/agent/src/sandbox/users.rs), mapped by shadow-utils' newuidmap/newgidmap,
# whose file capabilities no_new_privs would disable. The server itself runs no setuid program
# but those two; every agent still gets no_new_privs from bwrap.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
# The old name (before the rename to generic terms, 2026-11-19): host update helpers installed
# before it check `melissa-queen.service`. Keep for one release.
Alias=melissa-queen.service
