[Unit]
Description=Encrypt the Secrets already in k3s's datastore (once)
Documentation=file:///usr/libexec/melissa/k3s-secrets-encrypt
After=k3s.service
ConditionPathExists=/usr/bin/k3s

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/melissa/k3s-secrets-encrypt
# Waits up to 300 s for k3s's status, then up to 300 s for the re-encryption. Nothing waits for
# this unit; a failure is retried (k3s keeps the old Secrets readable meanwhile).
TimeoutStartSec=630
Restart=on-failure
RestartSec=30s

[Install]
# Starts whenever k3s does (a no-op once k3s says the rotation is finished).
WantedBy=k3s.service
