#!/bin/sh
# Runs before k3s starts. Links the airgap images shipped in /usr into k3s's /var directory,
# installs Melissa's deploy-on-start manifests, pins the node IP, and relabels k3s paths once
# (SELinux).
set -eu
. /usr/lib/melissa/k3s.lock
images=/var/lib/rancher/k3s/agent/images
manifests=/var/lib/rancher/k3s/server/manifests
mkdir -p "$images" "$manifests"
# Links to airgap tarballs of earlier k3s versions dangle after an image update; drop them.
for link in "$images"/k3s-airgap-*.tar.zst; do
    if [ -L "$link" ] && [ ! -e "$link" ]; then rm -f "$link"; fi
done
# The version is in the link name: /usr files all have mtime 0, so k3s can't spot changes by time.
ln -sfn "/usr/lib/melissa/k3s/images/k3s-airgap-images-${K3S_VERSION}-amd64.tar.zst" \
    "$images/k3s-airgap-${K3S_VERSION}.tar.zst"
for m in /usr/lib/melissa/k3s/manifests/*.yaml; do
    [ -e "$m" ] && install -m 0600 "$m" "$manifests/melissa-$(basename "$m")"
done
# Drop copies whose source is gone (renamed or removed, e.g. queen-rbac.yaml → server-rbac.yaml),
# so k3s stops applying them.
for m in "$manifests"/melissa-*.yaml; do
    [ -e "$m" ] || continue
    b=$(basename "$m")
    [ "$b" = melissa-gvisor-runtimeclass.yaml ] && continue # handled below
    [ -e "/usr/lib/melissa/k3s/manifests/${b#melissa-}" ] || rm -f "$m"
done
# gVisor for apps (docs/DECISIONS.md 2026-11-23): only where runsc and its containerd shim are, the
# containerd runtime entry (k3s doesn't detect runsc) and the `gvisor` RuntimeClass. Without them
# gVisor apps are refused (never run on runc). A template someone else wrote is left alone.
gvisor=/usr/lib/melissa/k3s/gvisor
tmpl=/var/lib/rancher/k3s/agent/etc/containerd/config-v3.toml.tmpl
ours() { [ ! -e "$tmpl" ] || head -n1 "$tmpl" | grep -q melissa-managed; }
if command -v runsc >/dev/null && command -v containerd-shim-runsc-v1 >/dev/null; then
    if ours; then
        mkdir -p "$(dirname "$tmpl")"
        install -m 0644 "$gvisor/config-v3.toml.tmpl" "$tmpl"
    else
        echo "k3s-prepare: $tmpl is not Melissa's; gVisor apps need its runsc entry" >&2
    fi
    install -m 0600 "$gvisor/runtimeclass.yaml" "$manifests/melissa-gvisor-runtimeclass.yaml"
else
    echo "k3s-prepare: runsc not found: no gVisor (apps that need it are not deployed)" >&2
    if ours; then rm -f "$tmpl"; fi
    rm -f "$manifests/melissa-gvisor-runtimeclass.yaml"
fi
stamp=/var/lib/rancher/.melissa-relabeled
if [ ! -e "$stamp" ]; then
    restorecon -R /var/lib/rancher /etc/rancher 2>/dev/null || true
    [ -d /var/lib/kubelet ] && restorecon -R /var/lib/kubelet || true
    touch "$stamp"
fi

# Pin the node IP (shared with the Nix packaging; see k3s-node-ip).
/usr/libexec/melissa/k3s-node-ip /run/melissa/k3s.env
