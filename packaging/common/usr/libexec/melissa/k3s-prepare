#!/bin/sh
# Runs before k3s starts. Links the airgap images shipped in /usr into k3s's /var directory,
# installs Melissa's deploy-on-start manifests, pins the node IP, and relabels k3s paths once
# (SELinux).
set -eu
. /usr/lib/melissa/k3s.lock
images=/var/lib/rancher/k3s/agent/images
manifests=/var/lib/rancher/k3s/server/manifests
mkdir -p "$images" "$manifests"
# Links to airgap tarballs of earlier k3s versions dangle after an image update; drop them.
for link in "$images"/k3s-airgap-*.tar.zst; do
    if [ -L "$link" ] && [ ! -e "$link" ]; then rm -f "$link"; fi
done
# The version is in the link name: /usr files all have mtime 0, so k3s can't spot changes by time.
ln -sfn "/usr/lib/melissa/k3s/images/k3s-airgap-images-${K3S_VERSION}-amd64.tar.zst" \
    "$images/k3s-airgap-${K3S_VERSION}.tar.zst"
for m in /usr/lib/melissa/k3s/manifests/*.yaml; do
    [ -e "$m" ] && install -m 0600 "$m" "$manifests/melissa-$(basename "$m")"
done
stamp=/var/lib/rancher/.melissa-relabeled
if [ ! -e "$stamp" ]; then
    restorecon -R /var/lib/rancher /etc/rancher 2>/dev/null || true
    [ -d /var/lib/kubelet ] && restorecon -R /var/lib/kubelet || true
    touch "$stamp"
fi

# Pin the node IP to the IPv4 address of the default route. Left alone, k3s also advertises the
# node's global IPv6 address, which SLAAC adds a second or two *after* network-online.target (an
# IPv4 DHCP lease is enough for NetworkManager-wait-online). k3s then sees "NodeIPs changed" and
# exits, twice (v4 -> v4+v6, then the stored v4 vs the new v4+v6). The cluster is single-stack
# IPv4, and changing IPv6 prefixes/privacy addresses would restart it at runtime too. A local
# `node-ip` in config.yaml(.d) wins; with no IPv4 default route (IPv6-only bee) k3s autodetects.
env=/run/melissa/k3s.env
mkdir -p /run/melissa
args=
if ! grep -qsE '^[[:space:]]*"?node-ip"?[[:space:]]*:' /etc/rancher/k3s/config.yaml /etc/rancher/k3s/config.yaml.d/*.yaml; then
    ip4=$(ip -4 -o route show default 2>/dev/null | sed -n '1s/.* src \([0-9.]*\).*/\1/p')
    if [ -z "$ip4" ]; then
        dev=$(ip -4 -o route show default 2>/dev/null | sed -n '1s/.* dev \([^ ]*\).*/\1/p')
        [ -n "$dev" ] && ip4=$(ip -4 -o addr show dev "$dev" scope global 2>/dev/null \
            | sed -n '1s/.* inet \([0-9.]*\)\/.*/\1/p')
    fi
    if [ -n "$ip4" ]; then args="--node-ip=$ip4"; else echo "k3s-prepare: no IPv4 default route; k3s picks the node IP" >&2; fi
fi
printf 'MELISSA_K3S_ARGS=%s\n' "$args" > "$env"
