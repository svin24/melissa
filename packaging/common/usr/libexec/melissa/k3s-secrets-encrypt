#!/bin/sh
# Encrypts the Secrets already in k3s's datastore, once (melissa-secrets-encrypt.service, root, after
# k3s). k3s runs with `secrets-encryption: true` (config.yaml.d/10-melissa.yaml): a new datastore
# encrypts every Secret from the start; a datastore from before keeps its old Secrets in plain text
# (still readable through the `identity` provider) until they are rewritten. k3s's single-server
# procedure does that (docs.k3s.io/cli/secrets-encrypt, "Encryption Key Rotation"): `rotate-keys`
# adds a new key and re-encrypts every Secret with it, no restart. Checked 2026-11-28 with k3s
# v1.37.2+k3s1 (packaging/container/README.md, "Secrets encryption").
#
# Idempotent and decided by k3s's own state, nothing of Melissa's:
#   stage start               never rotated (an older datastore, or a new one): rotate once
#   stage reencrypt_request/_active   a rotation under way (cut off by a restart): wait for it
#   stage reencrypt_finished  done; nothing to do
#   anything else             someone rotates by hand (prepare/rotate): left alone
# Encryption off (90-local.yaml says `secrets-encryption: false`) or an agent node: nothing to do.
#
# The key is /var/lib/rancher/k3s/server/cred/encryption-config.json: root only (kept 0600 here).
# Backups of the datastore are useless without it (docs/PLAN.md, "Secrets at rest"). Nothing of
# Melissa's reads it, and agents never see /var/lib/rancher.
set -eu
cred=/var/lib/rancher/k3s/server/cred
# Container: this device's cluster role (melissa-server cluster prepare). An agent has no datastore.
mode=server
if [ -r /run/melissa-cluster/k3s.env ]; then
    mode=$(sed -n 's/^MELISSA_K3S_MODE=//p' /run/melissa-cluster/k3s.env | tail -n 1)
fi
[ "${mode:-server}" = server ] || exit 0

WAIT=${WAIT:-300}
status() { k3s secrets-encrypt status 2>&1; }
field() { printf '%s\n' "$1" | sed -n "s/^$2: *//p" | head -n 1; }

# The status answers once the server and its node are up (a fresh boot: a minute or two).
end=$(( $(date +%s) + WAIT ))
until st=$(status); do
    if [ "$(date +%s)" -ge "$end" ]; then
        echo "k3s-secrets-encrypt: no status from k3s within ${WAIT}s: $st" >&2
        exit 1
    fi
    sleep 5
done

case "$(field "$st" 'Encryption Status')" in
    Enabled*) ;;
    *) echo "k3s-secrets-encrypt: encryption is off ($(field "$st" 'Encryption Status')); nothing to do"
       exit 0 ;;
esac
# Root only (k3s writes it 0600 today; keep it so).
[ -e "$cred/encryption-config.json" ] && chmod 0600 "$cred/encryption-config.json"
chmod 0700 "$cred"

stage=$(field "$st" 'Current Rotation Stage')
case "$stage" in
    reencrypt_finished) exit 0 ;;
    start)
        case "$(field "$st" 'Server Encryption Hashes')" in
            'All hashes match'*) ;;
            *) echo "k3s-secrets-encrypt: servers' encryption configs differ; not rotating" >&2
               exit 1 ;;
        esac
        echo "k3s-secrets-encrypt: encrypting the existing Secrets (rotate-keys)"
        k3s secrets-encrypt rotate-keys ;;
    reencrypt_request|reencrypt_active)
        echo "k3s-secrets-encrypt: a rotation is under way ($stage); waiting for it" ;;
    *)
        echo "k3s-secrets-encrypt: rotation stage '$stage' (a manual rotation?); left alone" >&2
        exit 0 ;;
esac

# k3s re-encrypts about 5 Secrets a second.
end=$(( $(date +%s) + WAIT ))
while :; do
    st=$(status) || st=
    stage=$(field "$st" 'Current Rotation Stage')
    [ "$stage" = reencrypt_finished ] && break
    if [ "$(date +%s)" -ge "$end" ]; then
        echo "k3s-secrets-encrypt: not finished within ${WAIT}s (stage '$stage')" >&2
        exit 1
    fi
    sleep 3
done
echo "k3s-secrets-encrypt: every Secret is encrypted ($(field "$st" 'Encryption Status'))"
