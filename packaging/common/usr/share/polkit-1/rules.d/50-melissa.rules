// Melissa: the queen runs as the unprivileged user `melissa`. It may restart itself (to use
// saved settings) and nothing else: no other units, verbs or arguments.
// See docs/DECISIONS.md (2026-11-19).
polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "melissa") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.lookup("verb") === "restart" && action.lookup("unit") === "melissa-queen.service") {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
