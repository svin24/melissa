# Melissa: server (web UI), k3s and the agent sandbox in one rootful container, systemd as PID 1.
# Template: install.sh fills in the @...@ values and writes /etc/containers/systemd/melissa.container.
# Quadlet turns it into melissa.service: `systemctl start|stop|status melissa`. The container is
# recreated from the image at every start; state lives in the melissa-var volume (/var, incl.
# /etc/melissa and k3s's node password, see the Containerfile).
# Docs: packaging/container/README.md.

[Unit]
Description=Melissa (server, k3s, agent sandbox)
Documentation=file:///usr/local/share/melissa/README.md
Wants=network-online.target
After=network-online.target
# Host side of Settings → Updates (fixed actions, requested through a bind-mounted directory).
Wants=melissa-update.path

[Container]
ContainerName=melissa
HostName=melissa
# Scheduled jobs run in local time: follow the host's time zone (the image defaults to UTC).
Timezone=local
Image=@IMAGE@
@AUTO_UPDATE_LINE@
# k3s mounts, writes netfilter rules and creates pod network namespaces; the agent sandbox needs
# nested namespaces. Rootful, this is root on the host (docs: "Security").
PodmanArgs=--privileged --systemd=always
# --privileged shares the host's /dev. Hide input devices (lid switch, power key, keyboards): nothing
# in Melissa needs them, and logind (masked in the image) must never act on them.
Tmpfs=/dev/input
# For `podman exec melissa melissa-server ...` run as root: read the server's config (/etc/melissa,
# [apps] addresses) like melissa-server.service does, not root's empty ~/.config.
Environment=XDG_CONFIG_HOME=/etc
# The default rootful bridge. The UI: host 127.0.0.1:UI_PORT → container :8081
# (melissa-ui-forward, nftables-filtered so pods can't reach it) → server on 127.0.0.1:8080.
Network=podman
PublishPort=@UI_BIND@:@UI_PORT@:8081
# App NodePorts 30000-30079 (first app port on the host: APP_PORT_BASE), TCP and UDP (game servers).
PublishPort=@BIND@:@APP_PORT_BASE@-@APP_PORT_LAST@:30000-30079
PublishPort=@BIND@:@APP_PORT_BASE@-@APP_PORT_LAST@:30000-30079/udp
# Tells the server where the app ports are published (BIND; empty: unknown), so app links leave
# out addresses BIND doesn't cover. The server can't test that by connecting: from inside the
# container a connect to the host's published address fails (no hairpin) even when it works from
# everywhere else. melissa-server.service gets it through PassEnvironment (10-container.conf).
Environment=MELISSA_PUBLISH_BIND=@PUBLISH_BIND@
Volume=melissa-var:/var
# Updates: the host helper writes status here (read-only inside) and picks up requests there.
Volume=/var/lib/melissa-container/status:/run/melissa-update:ro,z
Volume=/var/lib/melissa-container/request:/run/melissa-update-request:z
StopTimeout=60

[Service]
# The first start may pull the image.
TimeoutStartSec=900
Restart=on-failure
RestartSec=10
# Refresh what Settings → Updates shows (running image, previous image for a rollback).
ExecStartPost=-/usr/local/libexec/melissa/melissa-host-update status

[Install]
WantedBy=multi-user.target
