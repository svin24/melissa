#!/bin/bash
# melissa-host-update: the host side of Settings → Updates for the Melissa container. Runs as root on
# the host (installed by packaging/container/install.sh to /usr/local/libexec/melissa/).
#
#   melissa-host-update status     write the image status for Settings (also after every start)
#   melissa-host-update check      look for a newer image without downloading it (the registry's
#                                  digest for the image's tag; melissa-check.timer, daily)
#   melissa-host-update apply      download the newer image, snapshot k3s's datastore and restart
#                                  Melissa on it; if it does not come up, go back to the image it ran
#                                  before
#   melissa-host-update auto       apply, unless the newer image is one that failed or was rolled
#                                  back from (melissa-auto-update.timer, at the owner's time)
#   melissa-host-update rollback   restart Melissa on the previous image
#   melissa-host-update timers     write the automatic update time and switch the timer on or off
#                                  (SCHEDULE and AUTO_UPDATE in install.env)
#   melissa-host-update requests   melissa-update.service: carry out what the server asked for
#   melissa-host-update resume     finish an update or rollback that was cut off (a reboot, a crash,
#                                  a unit timeout): health check, else back to the image before
#   melissa-host-update resume-later   start `resume` in the background if one was cut off
#                                  (Melissa's ExecStartPost, the update units' ExecStopPost)
#
# The server (inside the container, unprivileged) asks by creating an empty file in
# /var/lib/melissa-container/request (bind-mounted at /run/melissa-update-request), named check,
# apply, rollback, auto-on, auto-off or schedule-<daily|mon|...|sun>-<00..23>. Only those names are
# acted on; file contents are never read and nothing else travels from the web.
# Results go to /var/lib/melissa-container/status (root, read-only inside at /run/melissa-update):
#   status.json  {"image", "auto_update", "schedule", "next_run", "tz_offset", "running", "staged",
#                 "available", "previous", "held", "just_updated"}
#   last.json    {"action", "ok", "at", "message", "kind", "version"}
#   action.json  while something runs: {"action", "step", "version", "bytes_done", "bytes_total",
#                 "started", "updated"}
# While an update or rollback switches images, $STATE/in-progress says which (mode, old and new
# image id, their versions): starts in between don't move the rollback tag, and a cut-off one is
# finished or undone by `resume`.
# Before every image switch of an update, k3s's datastore is copied off the stopped volume into
# $STATE/snapshots (root only, the newest 3; docs/PLAN.md Q23). Going back to an image whose k3s needs
# another datastore format (another Kubernetes minor, or Secrets encrypted or not) restores the copy
# taken when that image was left; the datastore it replaces is kept beside it.
set -u
umask 022

NAME=melissa
UNIT=melissa.service
STATE=/var/lib/melissa-container
UNITDIR=/etc/systemd/system
TIMER=melissa-auto-update.timer
CHECK_TIMER=melissa-check.timer
# The image Melissa ran before the current one (for a rollback). A local tag, never pushed.
PREVIOUS=localhost/melissa-rollback:previous
# How long a new image may take to start before Melissa goes back (seconds).
START_WAIT=${START_WAIT:-180}
# Melissa's /var (Quadlet Volume=melissa-var:/var) and how many datastore snapshots to keep.
VOLUME=melissa-var
KEEP_SNAPSHOTS=3

# install.sh records the settings it used (IMAGE, AUTO_UPDATE, SCHEDULE, ...).
IMAGE=
AUTO_UPDATE=off
SCHEDULE=daily-03

paths() {
    STATUS=$STATE/status
    REQUESTS=$STATE/request
    ENV_FILE=$STATE/install.env
    DROPIN=$UNITDIR/$TIMER.d/schedule.conf
    SNAPSHOTS=$STATE/snapshots
}
paths

load_env() {
    # shellcheck source=/dev/null
    [ -r "$ENV_FILE" ] && . "$ENV_FILE"
    valid_schedule "$SCHEDULE" || SCHEDULE=daily-03
}

# Printable ASCII only (so cutting bytes never splits a character), no quotes or backslashes.
# shellcheck disable=SC1003 # a backslash inside single quotes, as meant
clean() { printf '%s' "$1" | LC_ALL=C tr -d '\000-\037"\\\177-\377' | LC_ALL=C cut -c1-"${2:-300}"; }
now() { date +%s; }

write() { # write <name>: stdin -> $STATUS/<name>, atomically, 0644
    local tmp
    mkdir -p "$STATUS"
    tmp=$(mktemp "$STATUS/.$1.XXXXXX") || return 1
    cat > "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$STATUS/$1"
}

keep() { # keep <file under $STATE>: stdin, atomically (the helper's own records)
    local tmp
    tmp=$(mktemp "$STATE/.$1.XXXXXX") || return 1
    cat > "$tmp" && chmod 0644 "$tmp" && mv -f "$tmp" "$STATE/$1"
}

last() { # last <action> <ok:true|false> <kind> [message] [version]
    printf '{"action":"%s","ok":%s,"at":%s,"kind":"%s","message":"%s","version":"%s"}\n' \
        "$1" "$2" "$(now)" "$(clean "$3" 20)" "$(clean "${4:-}")" "$(clean "${5:-}" 64)" | write last.json
    echo "melissa-host-update: $1 ok=$2 ${4:-}"
}

# --- What runs now (action.json, for the page's progress) ----------------------------------------

ACT_STARTED=0
RESTORED=
SNAP_ERR=
act() { # act <action> <step> [version] [bytes done] [bytes total]
    [ "$ACT_STARTED" = 0 ] && ACT_STARTED=$(now)
    printf '{"action":"%s","step":"%s","version":"%s","bytes_done":%s,"bytes_total":%s,"started":%s,"updated":%s}\n' \
        "$1" "$2" "$(clean "${3:-}" 64)" "${4:-0}" "${5:-0}" "$ACT_STARTED" "$(now)" | write action.json
}
act_done() { rm -f "$STATUS/action.json"; ACT_STARTED=0; }

# One action at a time (the timers and the server's requests). A check skips when busy.
lock() { exec 9>"$STATE/lock" && flock "$@" 9; }

# --- Images ---------------------------------------------------------------------------------------

running_id() { podman container inspect "$NAME" --format '{{.Image}}' 2>/dev/null; }
image_id() { podman image inspect "$1" --format '{{.Id}}' 2>/dev/null; }
ref() { # the image the Quadlet runs
    [ -n "$IMAGE" ] && { echo "$IMAGE"; return; }
    podman container inspect "$NAME" --format '{{.ImageName}}' 2>/dev/null
}
# The manifest digests an image was pulled by (sha256:..., space separated).
digests() {
    podman image inspect "$1" --format '{{range .RepoDigests}}{{.}} {{end}}' 2>/dev/null \
        | tr ' ' '\n' | sed -n 's/.*@\(sha256:[0-9a-f]*\)$/\1/p' | sort -u | paste -sd ' '
}
label() { # label <image> <name>
    local v
    v=$(podman image inspect "$1" --format "{{index .Labels \"$2\"}}" 2>/dev/null) || return 0
    [ "$v" = "<no value>" ] || printf '%s' "$v"
}

image_json() { # image_json <image ref or id> -> {"id","digest","created","version","revision"} or null
    local out id digest created version revision
    out=$(podman image inspect "$1" --format \
        '{{.Id}}|{{.Digest}}|{{.Created.UTC.Format "2006-01-02T15:04:05Z"}}|{{index .Labels "org.opencontainers.image.version"}}|{{index .Labels "org.opencontainers.image.revision"}}' \
        2>/dev/null) || { echo null; return; }
    IFS='|' read -r id digest created version revision <<<"$out"
    [ "$version" = "<no value>" ] && version=
    [ "$revision" = "<no value>" ] && revision=
    printf '{"id":"%s","digest":"%s","created":"%s","version":"%s","revision":"%s"}' \
        "$(clean "$id" 80)" "$(clean "$digest" 80)" "$(clean "$created" 40)" \
        "$(clean "$version" 64)" "$(clean "$revision" 64)"
}

# Remember which image ran last; when it changes (apply, rollback, auto), keep the one before
# under $PREVIOUS so a rollback can return to it.
note_running() {
    local cur seen old
    # Mid-update or mid-rollback: a start in between (the new image, or the old one put back) is
    # not a new "previous"; the action records the outcome itself.
    [ -e "$STATE/in-progress" ] && return 0
    cur=$(running_id) || return 0
    [ -n "$cur" ] || return 0
    seen=$(cat "$STATE/running-id" 2>/dev/null || true)
    if [ -n "$seen" ] && [ "$seen" != "$cur" ] && podman image exists "$seen"; then
        old=$(image_id "$PREVIOUS" || true)
        podman tag "$seen" "$PREVIOUS"
        # The image before that is no longer needed (refused if anything else still uses it).
        if [ -n "$old" ] && [ "$old" != "$seen" ] && [ "$old" != "$cur" ]; then
            podman rmi "$old" >/dev/null 2>&1 || true
        fi
    fi
    printf '%s\n' "$cur" > "$STATE/running-id"
}

# --- The registry, without downloading ------------------------------------------------------------

# remote <ref>: the tag's manifest digest (R_DIGEST) and, with skopeo, its version, revision and
# download size (R_VERSION, R_REVISION, R_SIZE). Without skopeo, one HEAD request for the digest.
remote() {
    local out sizes s
    R_DIGEST='' R_VERSION='' R_REVISION='' R_SIZE=0 R_ERR=''
    if command -v skopeo >/dev/null 2>&1; then
        out=$(skopeo --command-timeout 2m inspect --no-tags --format \
            '{{.Digest}}|{{index .Labels "org.opencontainers.image.version"}}|{{index .Labels "org.opencontainers.image.revision"}}|{{range .LayersData}}{{.Size}} {{end}}' \
            "docker://$1" 2>&1) || { R_ERR=$out; return 1; }
        IFS='|' read -r R_DIGEST R_VERSION R_REVISION sizes <<<"$out"
        [ "$R_VERSION" = "<no value>" ] && R_VERSION=
        [ "$R_REVISION" = "<no value>" ] && R_REVISION=
        for s in $sizes; do case "$s" in *[!0-9]*) ;; *) R_SIZE=$((R_SIZE + s)) ;; esac; done
    else
        R_DIGEST=$(registry_digest "$1") || { R_ERR=$R_DIGEST; R_DIGEST=; return 1; }
    fi
    case "$R_DIGEST" in sha256:*) ;; *) R_ERR="no digest for $1"; R_DIGEST=; return 1 ;; esac
    R_VERSION=$(clean "$R_VERSION" 64); R_REVISION=$(clean "$R_REVISION" 64)
}

# registry_digest <host/repo:tag>: the Docker-Content-Digest of the tag (anonymous token if asked).
registry_digest() {
    local host rest repo tag url hdrs auth realm service scope token
    host=${1%%/*}; rest=${1#*/}
    case "$rest" in *@sha256:*) echo "${rest#*@}"; return 0 ;; esac
    case "${rest##*/}" in *:*) repo=${rest%:*}; tag=${rest##*:} ;; *) repo=$rest; tag=latest ;; esac
    [ "$host" = docker.io ] && host=registry-1.docker.io
    url="https://$host/v2/$repo/manifests/$tag"
    local accept="Accept: application/vnd.oci.image.index.v1+json, application/vnd.oci.image.manifest.v1+json, application/vnd.docker.distribution.manifest.list.v2+json, application/vnd.docker.distribution.manifest.v2+json"
    hdrs=$(curl -sSI --max-time 60 -H "$accept" "$url" 2>&1) || { echo "$hdrs"; return 1; }
    if grep -qi '^HTTP/[0-9.]* 401' <<<"$hdrs"; then
        auth=$(grep -i '^www-authenticate: *bearer' <<<"$hdrs" | tr -d '\r')
        realm=$(sed -n 's/.*realm="\([^"]*\)".*/\1/p' <<<"$auth")
        service=$(sed -n 's/.*service="\([^"]*\)".*/\1/p' <<<"$auth")
        scope=$(sed -n 's/.*scope="\([^"]*\)".*/\1/p' <<<"$auth")
        case "$realm" in https://*) ;; *) echo "registry asks for an unknown sign-in"; return 1 ;; esac
        token=$(curl -sS --max-time 60 -G --data-urlencode "service=$service" \
            --data-urlencode "scope=$scope" "$realm" | sed -n 's/.*"token" *: *"\([^"]*\)".*/\1/p')
        [ -n "$token" ] || { echo "no token from $realm"; return 1; }
        # The token on stdin, not in the process list.
        hdrs=$(printf 'Authorization: Bearer %s\n' "$token" \
            | curl -sSI --max-time 60 -H "$accept" -H @- "$url" 2>&1) || { echo "$hdrs"; return 1; }
    fi
    grep -qi '^HTTP/[0-9.]* 200' <<<"$hdrs" || { head -n 1 <<<"$hdrs" | tr -d '\r'; return 1; }
    grep -i '^docker-content-digest:' <<<"$hdrs" | tr -d '\r' | awk '{print $2}' | head -n 1
}

# The digest runs now (or is the one the tag already points to locally).
is_current() { # is_current <digest> <image id>
    case " $(digests "$2") " in *" $1 "*) return 0 ;; esac
    return 1
}

# --- Held versions (failed or rolled back from; automatic updates skip them) -----------------------

held_digests() { sed -n 's/.*"digests":"\([^"]*\)".*/\1/p' "$STATE/held.json" 2>/dev/null; }
held_id() { sed -n 's/.*"id":"\([^"]*\)".*/\1/p' "$STATE/held.json" 2>/dev/null; }
is_held() { # is_held <digest or image id>
    [ -n "$1" ] && [ -r "$STATE/held.json" ] || return 1
    [ "$(held_id)" = "$1" ] && return 0
    case " $(held_digests) " in *" $1 "*) return 0 ;; esac
    return 1
}
hold() { # hold <image id> <reason: failed|rolled_back> [message]
    printf '{"id":"%s","digests":"%s","version":"%s","revision":"%s","reason":"%s","at":%s,"message":"%s"}\n' \
        "$(clean "$1" 80)" "$(clean "$(digests "$1")" 400)" \
        "$(clean "$(label "$1" org.opencontainers.image.version)" 64)" \
        "$(clean "$(label "$1" org.opencontainers.image.revision)" 64)" \
        "$2" "$(now)" "$(clean "${3:-}")" | keep held.json
}

# --- status.json ----------------------------------------------------------------------------------

next_run() { # the automatic update's next start (Unix seconds), or null
    local us
    [ "$AUTO_UPDATE" = off ] && { echo null; return; }
    us=$(systemctl show "$TIMER" -p NextElapseUSecRealtime --value --timestamp=unix 2>/dev/null)
    us=${us#@}
    case "$us" in ''|*[!0-9]*) echo null ;; *) echo "$us" ;; esac
}

available_json() { # the update the last check found, while it is newer than what runs and not held
    local cur=$1 f=$STATE/available.json
    [ -r "$f" ] || { echo null; return; }
    [ "$(sed -n 's/.*"for":"\([^"]*\)".*/\1/p' "$f")" = "$cur" ] || { echo null; return; }
    is_held "$(sed -n 's/.*"digest":"\([^"]*\)".*/\1/p' "$f")" && { echo null; return; }
    sed -n 's/,"for":"[^"]*"//; 1p' "$f"
}

status() {
    local r cur staged=null prev=null held=null updated=null dserr=null refid
    note_running
    r=$(ref)
    cur=$(running_id || true)
    # A newer image already in local storage under the same name: used at the next start.
    refid=$(image_id "$r" || true)
    if [ -n "$refid" ] && [ -n "$cur" ] && [ "$refid" != "$cur" ] && ! is_held "$refid"; then
        staged=$(image_json "$refid")
    fi
    if podman image exists "$PREVIOUS" && [ "$(image_id "$PREVIOUS")" != "$cur" ]; then
        prev=$(image_json "$PREVIOUS")
    fi
    [ -r "$STATE/held.json" ] && held=$(head -n 1 "$STATE/held.json")
    [ -r "$STATE/updated.json" ] && updated=$(head -n 1 "$STATE/updated.json")
    # A datastore restore that failed half way (datastore_broken): until the owner removes the file.
    [ -r "$STATE/datastore-error" ] && dserr="\"$(clean "$(head -n 1 "$STATE/datastore-error")" 400)\""
    printf '{"image":"%s","auto_update":"%s","schedule":"%s","next_run":%s,"tz_offset":"%s","running":%s,"staged":%s,"available":%s,"previous":%s,"held":%s,"just_updated":%s,"datastore_error":%s}\n' \
        "$(clean "$r" 200)" "$(clean "$AUTO_UPDATE" 20)" "$SCHEDULE" "$(next_run)" "$(date +%z)" \
        "$( [ -n "$cur" ] && image_json "$cur" || echo null)" "$staged" "$(available_json "$cur")" \
        "$prev" "$held" "$updated" "$dserr" \
        | write status.json
}

# What this helper can do, for the image (read-only inside at /run/melissa-update/helper): k3s-prepare
# turns Secrets encryption on for an older datastore only once the host snapshots before updates.
HELPER_FEATURES="snapshots=1"
helper_file() { printf '%s\n' "$HELPER_FEATURES" | write helper; }

# --- Health ---------------------------------------------------------------------------------------

# A command inside the container, for health probes that poll every few seconds. Quiet: otherwise
# each one writes two long podman events (exec, exec_died) and a harmless conmon warning to this
# unit's journal and buries the real lines. conmon errors still reach the journal; the exit code
# is the answer. (One exec: `systemctl is-active` with several units is 0 when any is active.)
probe() { podman --events-backend=none --log-level=error exec "$NAME" "$@" 2>/dev/null; }

wait_up() { # wait_up <image id> [action version]: Melissa runs it and her server is active
    local want=$1 end=$(( $(now) + START_WAIT ))
    while [ "$(now)" -lt "$end" ]; do
        [ -n "${2:-}" ] && act "$2" health "${3:-}"
        if systemctl is-active -q "$UNIT" && [ "$(running_id)" = "$want" ] \
            && probe systemctl is-active -q melissa-server.service melissa-queen.service; then
            return 0
        fi
        sleep 3
    done
    return 1
}

# --- k3s datastore snapshots ----------------------------------------------------------------------

# k3s's server state on the volume, as the host sees it (fails without the volume).
k3s_server_dir() {
    local m
    m=$(podman volume inspect "$VOLUME" --format '{{.Mountpoint}}' 2>/dev/null) || return 1
    [ -n "$m" ] && [ -d "$m" ] || return 1
    echo "$m/lib/rancher/k3s/server"
}

# datastore_format <image>: what the image's k3s makes of the datastore, "<Kubernetes minor>
# <encrypted|plain>" (e.g. "1.37 encrypted"), read from its files without booting it. A newer
# Kubernetes minor migrates stored objects (an older one can't be trusted to read them back), and
# k3s without secrets-encryption can't read encrypted Secrets.
datastore_format() {
    local out v e
    # shellcheck disable=SC2016 # expanded by the image's shell
    out=$(podman run --rm --pull=never --network=none --entrypoint /bin/sh "$1" -c \
        '. /usr/lib/melissa/k3s.lock; e=plain
         grep -qx "secrets-encryption: true" /etc/rancher/k3s/config.yaml.d/10-melissa.yaml && e=encrypted
         echo "$K3S_VERSION $e"' 2>/dev/null) || return 1
    read -r v e <<<"$out"
    [[ ${v#v} =~ ^([0-9]+\.[0-9]+)\. ]] || return 1
    case "$e" in encrypted|plain) ;; *) return 1 ;; esac
    echo "${BASH_REMATCH[1]} $e"
}

# Which datastore this is: a hash of k3s's server token (new with every datastore, e.g. after a
# factory reset). Empty without one.
datastore_id() { [ -r "$1/token" ] && sha256sum < "$1/token" | cut -c1-64; }

meta() { sed -n "s/^$2=//p" "$1/meta" 2>/dev/null | head -n 1; } # meta <snapshot dir> <key>

# A snapshot name for <image id> taken now: <UTC time, to the nanosecond>-<image id, 12>.
snapshot_name() { echo "$(date -u +%Y%m%dT%H%M%S.%NZ)-${1:0:12}"; }

# The newest KEEP_SNAPSHOTS (names start with their UTC time); half-written ones go.
prune_snapshots() {
    local all n
    rm -rf "$SNAPSHOTS"/*.partial
    mapfile -t all < <(find "$SNAPSHOTS" -mindepth 1 -maxdepth 1 -type d -name '2*Z-*' ! -name '*.partial' | sort)
    n=$(( ${#all[@]} - KEEP_SNAPSHOTS ))
    if [ "$n" -gt 0 ]; then rm -rf -- "${all[@]:0:n}"; fi
    return 0
}

# snapshot <action> <image id> <version> <new image id> <name>: stop Melissa and copy k3s's datastore
# (server/db), its token and keys (server/cred, with the Secrets encryption key) off the volume into
# $SNAPSHOTS/<name>. Stopped, so the copy is consistent (k3s's documented SQLite backup is a copy of
# server/db plus the token; the key decrypts its Secrets). meta records the image left and the one
# coming with the datastore format each needs, and which datastore it is (datastore_id). Nothing to
# copy (an agent node, no datastore): 0, Melissa left running. SNAP_ERR says why it failed.
snapshot() {
    local dir need free dst tmp fmt to_fmt
    SNAP_ERR=
    dir=$(k3s_server_dir) || { echo "melissa-host-update: no volume $VOLUME, no datastore snapshot"; return 0; }
    [ -d "$dir/db" ] || { echo "melissa-host-update: no k3s datastore on $VOLUME, no snapshot"; return 0; }
    fmt=$(datastore_format "$2") || fmt=unknown
    to_fmt=$(datastore_format "$4") || to_fmt=unknown
    act "$1" snapshot "$3"
    systemctl stop "$UNIT" || { SNAP_ERR="could not stop Melissa"; return 1; }
    if ! ( umask 077; mkdir -p "$SNAPSHOTS" ) || ! chmod 0700 "$SNAPSHOTS"; then
        SNAP_ERR="could not create $SNAPSHOTS"; return 1
    fi
    prune_snapshots
    need=$(du -sb "$dir/db" "$dir/cred" 2>/dev/null | awk '{ s += $1 } END { print s + 0 }')
    free=$(df -PB1 "$SNAPSHOTS" | awk 'NR == 2 { print $4 }')
    # Room for the copy and as much again (the datastore keeps growing on the same disk).
    if [ "$(( need * 2 ))" -gt "${free:-0}" ]; then
        SNAP_ERR="not enough disk space for a datastore snapshot ($(( need / 1048576 )) MiB, twice that needed)"
        return 1
    fi
    dst=$SNAPSHOTS/$5; tmp=$dst.partial
    [ ! -e "$dst" ] || { SNAP_ERR="snapshot $5 exists already"; return 1; }
    rm -rf "$tmp"
    if ( umask 077; mkdir "$tmp" ) && cp -a "$dir/db" "$tmp/db" \
        && { [ ! -e "$dir/cred" ] || cp -a "$dir/cred" "$tmp/cred"; } \
        && { [ ! -e "$dir/token" ] || cp -a "$dir/token" "$tmp/token"; } \
        && printf 'image=%s\nformat=%s\nto_image=%s\nto_format=%s\ndatastore=%s\nversion=%s\nat=%s\n' \
            "$2" "$fmt" "$4" "$to_fmt" "$(datastore_id "$dir")" "$(clean "$3" 64)" "$(now)" > "$tmp/meta" \
        && mv "$tmp" "$dst"; then
        prune_snapshots
        echo "melissa-host-update: k3s datastore ($fmt) saved in $dst"
        return 0
    fi
    rm -rf "$tmp"
    SNAP_ERR="could not copy k3s's datastore to $SNAPSHOTS"
    return 1
}

# The Secrets key and its rotation state: what goes back with a restored datastore.
KEYS="encryption-config.json encryption-state.json"

# restore_if_needed <action> <snapshot name> <image going back to> <image leaving> <version>: when
# that snapshot was taken leaving the image going back, for the image now leaving, and the two need
# different datastore formats (meta, recorded at snapshot time: a Kubernetes minor bump, or Secrets
# encryption switched), stop Melissa and put the snapshot back. Only that snapshot (the one this
# update took or, for a rollback, the one the update recorded): a missing or half-written one means
# the new image never ran on the datastore, nothing to undo. Refused when the live datastore is not
# the one the snapshot came from (a factory reset since). Changes to the cluster since the update
# (apps deployed or removed) go with it; app data volumes stay.
#
# Staged on the volume's filesystem first (db.restore, <key>.restore), then swapped in with renames;
# any failure puts the original back. The replaced datastore and keys end up in the snapshot's
# replaced-<time>/.
# Returns 0 (restored, or nothing to do), 1 (not restored; the datastore is as it was), 2 (the swap
# failed half way and could not be undone: the datastore's state is unknown, do not start Melissa).
# RESTORED says what happened (for last.json).
restore_if_needed() {
    local snap want have dir keep k need free live
    RESTORED=
    snap=$SNAPSHOTS/$2
    if [ -z "$2" ] || [ ! -d "$snap" ] || [ ! -r "$snap/meta" ]; then
        echo "melissa-host-update: no datastore snapshot from this update (${2:-none}): datastore kept"
        return 0
    fi
    if [ "$(meta "$snap" image)" != "$3" ] || [ "$(meta "$snap" to_image)" != "$4" ]; then
        echo "melissa-host-update: snapshot $2 is not of ${3:0:12} -> ${4:0:12}: datastore kept"
        return 0
    fi
    want=$(meta "$snap" format); have=$(meta "$snap" to_format)
    if [ -z "$want" ] || [ "$want" = unknown ] || [ -z "$have" ] || [ "$have" = unknown ] || [ "$want" = "$have" ]; then
        echo "melissa-host-update: k3s datastore kept (${have:-unknown}, ${3:0:12} needs ${want:-unknown})"
        return 0
    fi
    dir=$(k3s_server_dir) || { RESTORED="; datastore not restored: no volume $VOLUME"; return 1; }
    live=$(datastore_id "$dir")
    if [ -z "$live" ] || [ "$live" != "$(meta "$snap" datastore)" ]; then
        RESTORED="; datastore not restored: it is not the one snapshot $2 came from (a factory reset since?)"
        echo "melissa-host-update${RESTORED#;}" >&2
        return 1
    fi
    need=$(du -sb "$snap/db" | awk '{ print $1 + 0 }')
    free=$(df -PB1 "$dir" | awk 'NR == 2 { print $4 }')
    if [ "$(( need * 2 ))" -gt "${free:-0}" ]; then
        RESTORED="; datastore not restored: not enough disk space ($(( need / 1048576 )) MiB, twice that needed)"
        return 1
    fi
    echo "melissa-host-update: ${4:0:12} left the datastore as $have, ${3:0:12} needs $want: restoring $snap"
    act "$1" restore "$5"
    systemctl stop "$UNIT" || { RESTORED="; datastore not restored: could not stop Melissa"; return 1; }
    keep=$snap/replaced-$(date -u +%Y%m%dT%H%M%SZ)
    # Stage: nothing live changes yet.
    unstage() { rm -rf "$dir/db.restore"; for k in $KEYS; do rm -f "$dir/cred/$k.restore"; done; }
    unstage
    if ! { ( umask 077; mkdir -p "$keep/cred" ) \
        && { [ ! -d "$dir/cred" ] || cp -a "$dir/cred/." "$keep/cred/"; } \
        && cp -a "$snap/db" "$dir/db.restore" && stage_keys "$snap" "$dir"; }; then
        unstage
        RESTORED="; datastore not restored: could not stage the snapshot (the datastore is as it was)"
        return 1
    fi
    # Swap (renames on one filesystem). The keys first: put back from $keep/cred on failure. The
    # record lets `resume` undo a swap a crash cut off.
    printf '%s\n%s\n' "$dir" "$keep" | keep restore-swap
    if ! swap_in "$dir" "$keep"; then
        if swap_back "$dir" "$keep"; then
            rm -f "$STATE/restore-swap"; unstage
            RESTORED="; datastore not restored: the swap failed and was undone (the datastore is as it was)"
            return 1
        fi
        RESTORED="; RESTORING K3S'S DATASTORE FAILED HALF WAY: its state is unknown; Melissa is left stopped (copies in $keep and $snap)"
        return 2
    fi
    rm -f "$STATE/restore-swap"
    # The replaced datastore off the volume, beside the snapshot (a copy across filesystems).
    if cp -a "$dir/db.replaced" "$keep/db"; then rm -rf "$dir/db.replaced"; fi
    RESTORED="; k3s's datastore restored from before the update ($2)"
    return 0
}

stage_keys() { # stage_keys <snapshot dir> <server dir>
    local k
    for k in $KEYS; do
        if [ -e "$1/cred/$k" ]; then cp -a "$1/cred/$k" "$2/cred/$k.restore" || return 1; fi
    done
}

# swap_in <server dir> <keep dir>: the staged keys and datastore in place of the live ones.
swap_in() {
    local k
    for k in $KEYS; do
        if [ -e "$1/cred/$k.restore" ]; then mv -f "$1/cred/$k.restore" "$1/cred/$k" || return 1
        else rm -f "$1/cred/$k" || return 1; fi
    done
    rm -rf "$1/db.replaced"
    if [ -e "$1/db" ]; then mv "$1/db" "$1/db.replaced" || return 1; fi
    mv "$1/db.restore" "$1/db"
}

# swap_back <server dir> <keep dir>: undo a partial swap_in (the keys from the copy, the datastore by
# rename).
swap_back() {
    local k
    for k in $KEYS; do
        rm -f "$1/cred/$k"
        if [ -e "$2/cred/$k" ]; then cp -a "$2/cred/$k" "$1/cred/$k" || return 1; fi
    done
    if [ -e "$1/db.replaced" ]; then
        if [ -e "$1/db" ]; then rm -rf "$1/db" || return 1; fi
        mv "$1/db.replaced" "$1/db" || return 1
    fi
    [ -e "$1/db" ]
}

# A restore that failed half way: say so in status.json (datastore_error) and last.json, leave Melissa
# stopped. Updates and rollbacks refuse until the owner has looked and removed $STATE/datastore-error.
datastore_broken() { # datastore_broken <action> <message> [version]
    printf '%s\n' "$(clean "$2" 400)" | keep datastore-error
    unmark; act_done; status
    last "$1" false datastore "$2" "${3:-}"
    echo "melissa-host-update: $2" >&2
}
datastore_blocked() { # datastore_blocked <action>: refuse while a failed restore waits for the owner
    [ -e "$STATE/datastore-error" ] || return 1
    last "$1" false datastore "k3s's datastore needs attention first: $(head -c 300 "$STATE/datastore-error")"
}

# A swap a crash cut off (resume): put the original datastore and keys back. 1 if that fails too.
recover_swap() {
    local dir keep
    [ -r "$STATE/restore-swap" ] || return 0
    { read -r dir; read -r keep; } < "$STATE/restore-swap"
    echo "melissa-host-update: undoing a datastore restore that was cut off"
    if [ -n "$dir" ] && [ -n "$keep" ] && swap_back "$dir" "$keep"; then
        rm -rf "$dir/db.restore"; rm -f "$STATE/restore-swap"; return 0
    fi
    return 1
}

# --- Switching images -----------------------------------------------------------------------------

# restart_unit <action> <step> [version]: restart Melissa, refreshing action.json meanwhile (a start
# can take minutes; the page treats an action not refreshed for 15 minutes as gone).
restart_unit() {
    local pid rc
    act "$1" "$2" "${3:-}"
    systemctl restart "$UNIT" &
    pid=$!
    while kill -0 "$pid" 2>/dev/null; do
        act "$1" "$2" "${3:-}"
        sleep 5
    done
    wait "$pid"; rc=$?
    return "$rc"
}

# mark <mode> <old id> <new id> <old version> <new version> [snapshot name]
mark() { printf '%s\n' "$@" | keep in-progress; }
unmark() { rm -f "$STATE/in-progress"; }

# update_done <mode> <old id> <new id> <old version> <new version> [snapshot name]: the new image runs
# and answers. The snapshot this update took is the one a rollback to the old image may restore.
update_done() {
    rm -f "$STATE/available.json" "$STATE/held.json"
    if [ -n "${6:-}" ] && [ -d "$SNAPSHOTS/$6" ]; then printf '%s %s\n' "$2" "$6" | keep rollback-snapshot
    else rm -f "$STATE/rollback-snapshot"; fi
    printf '{"from":"%s","from_revision":"%s","to":"%s","to_revision":"%s","at":%s}\n' \
        "$(clean "$4" 64)" "$(clean "$(label "$2" org.opencontainers.image.revision)" 64)" \
        "$(clean "$5" 64)" "$(clean "$(label "$3" org.opencontainers.image.revision)" 64)" \
        "$(now)" | keep updated.json
    unmark; act_done; status; last "$1" true updated "running ${3:0:12}" "$5"
}

# update_undo <mode> <old id> <new id> <old version> <new version> <ref> <why> [snapshot name]: the
# new image did not come up; hold it, put the old one back under the name (and the datastore this
# update's snapshot holds, if the formats differ) and restart on it.
update_undo() {
    local rc=0
    hold "$3" failed "$7"
    podman tag "$2" "$6"
    restore_if_needed rollback "${8:-}" "$2" "$3" "$4" || rc=$?
    if [ "$rc" = 2 ]; then
        datastore_broken "$1" "the new image (${3:0:12}) did not start$RESTORED" "$5"
        return 1
    fi
    restart_unit rollback restart "$4"
    wait_up "$2" rollback "$4" || true
    unmark; act_done; status
    last "$1" false no_start "the new image (${3:0:12}) did not start; back on ${2:0:12}$RESTORED" "$5"
}

# rollback_done <old id> <new id> <old version> <new version>: back on the previous image.
rollback_done() {
    rm -f "$STATE/available.json" "$STATE/updated.json" "$STATE/rollback-snapshot"
    unmark; act_done; status; last rollback true rolled_back "running ${2:0:12}$RESTORED" "$4"
}

# rollback_undo <old id> <new id> <old version> <new version> <ref>: the previous image did not
# start; put back the one that ran (no longer held) so Melissa is up again.
rollback_undo() {
    rm -f "$STATE/held.json"
    podman tag "$1" "$5"
    restart_unit rollback restart "$3"
    wait_up "$1" rollback "$3" || true
    unmark; act_done; status
    last rollback false no_start "the previous image did not start; back on ${1:0:12}" "$4"
}

# Finish what a cut-off update or rollback left: if the new image runs, check it as the action would
# have; otherwise go back to the old one.
resume() {
    local mode old new from to snap r cur
    lock -w 3600 || return 1
    if ! recover_swap; then
        datastore_broken resume "a datastore restore was cut off and could not be undone; Melissa is left stopped (see $STATE/restore-swap)"
        return 1
    fi
    [ -r "$STATE/in-progress" ] || return 0
    snap=
    { read -r mode; read -r old; read -r new; read -r from; read -r to; read -r snap; } < "$STATE/in-progress"
    case "$mode" in apply|auto|rollback) ;; *) unmark; return 0 ;; esac
    r=$(ref); cur=$(running_id || true)
    echo "melissa-host-update: finishing a $mode that was cut off (${old:0:12} -> ${new:0:12})"
    if [ -n "$new" ] && [ "$cur" = "$new" ] && wait_up "$new" "$mode" "$to"; then
        if [ "$mode" = rollback ]; then rollback_done "$old" "$new" "$from" "$to"
        else update_done "$mode" "$old" "$new" "$from" "$to" "$snap"; fi
        return 0
    fi
    if [ -n "$old" ] && [ "$cur" = "$old" ]; then
        # The switch never happened: make sure the name points at what runs, and say so.
        podman tag "$old" "$r" 2>/dev/null || true
        [ "$mode" = rollback ] && rm -f "$STATE/held.json"
        unmark; act_done; status
        last "$mode" false interrupted "cut off before the restart; still on ${old:0:12}" "$to"
        return 1
    fi
    [ -n "$old" ] || { unmark; act_done; status; return 1; }
    if [ "$mode" = rollback ]; then rollback_undo "$old" "$new" "$from" "$to" "$r"
    else update_undo "$mode" "$old" "$new" "$from" "$to" "$r" \
        "Melissa did not answer after the update was cut off (a restart or a crash)" "$snap"; fi
    return 1
}

# A cut-off action: the marker is there and nothing holds the lock.
cut_off() { [ -e "$STATE/in-progress" ] && flock -n "$STATE/lock" true; }

resume_later() {
    cut_off || return 0
    systemd-run --no-block --quiet --collect --unit=melissa-update-resume \
        "$(readlink -f "$0")" resume 2>/dev/null || true
}

# --- Actions --------------------------------------------------------------------------------------

check() {
    local r cur
    lock -n || { echo "melissa-host-update: busy, check skipped"; return 0; }
    r=$(ref); cur=$(running_id || true)
    case "$r" in
    localhost/*)
        # A local image (built here or `podman load`ed): nothing to look up.
        rm -f "$STATE/available.json"
        status; last check true up_to_date "local image: load a newer one with podman load"; return 0 ;;
    esac
    act check check
    if ! remote "$r"; then
        act_done; status; last check false check "$R_ERR"; return 1
    fi
    if [ -z "$cur" ] || is_current "$R_DIGEST" "$cur"; then
        rm -f "$STATE/available.json"
        act_done; status; last check true up_to_date "up to date"
        return 0
    fi
    printf '{"id":"","digest":"%s","created":"","version":"%s","revision":"%s","size":%s,"for":"%s"}\n' \
        "$R_DIGEST" "$R_VERSION" "$R_REVISION" "$R_SIZE" "$cur" | keep available.json
    # A newer image than the one held back: the hold has done its job.
    if [ -r "$STATE/held.json" ] && ! is_held "$R_DIGEST"; then rm -f "$STATE/held.json"; fi
    act_done; status
    if is_held "$R_DIGEST"; then last check true held "the newer image is held back" "$R_VERSION"
    else last check true available "an update is available" "$R_VERSION"; fi
}

# pull <ref> <size> <action> <version>: download with progress in action.json (about once a second;
# podman's temporary download directory grows as it fetches). Never 100 % before the pull is done.
pull() {
    local tmp out pid size got cap rc
    tmp=$STATE/pull-tmp; out=$(mktemp "$STATE/.pull.XXXXXX")
    rm -rf "$tmp"; mkdir -p "$tmp"
    TMPDIR=$tmp podman pull -q "$1" > "$out" 2>&1 &
    pid=$!
    size=$2; cap=$(( size * 99 / 100 ))
    while kill -0 "$pid" 2>/dev/null; do
        got=$(du -sb "$tmp" 2>/dev/null | cut -f1); got=${got:-0}
        [ "$size" -gt 0 ] && [ "$got" -gt "$cap" ] && got=$cap
        act "$3" download "$4" "$got" "$size"
        sleep 1
    done
    wait "$pid"; rc=$?
    PULL_OUT=$(tail -n 5 "$out")
    rm -rf "$tmp" "$out"
    return "$rc"
}

# update <apply|auto>: download what the tag points to, restart on it, wait for the server, and go
# back if it does not come up (the version is then held: automatic updates skip it).
update() {
    local mode=$1 r cur new from to snap
    lock -w 3600 || { last "$mode" false busy "another update is running"; return 1; }
    r=$(ref); cur=$(running_id) || { last "$mode" false not_running "Melissa is not running"; return 1; }
    from=$(label "$cur" org.opencontainers.image.version)
    act "$mode" check
    case "$r" in
    localhost/*)
        new=$(image_id "$r")
        if [ "$mode" = auto ] && is_held "$new"; then
            act_done; status; last auto true held "the local image is held back"; return 0
        fi ;;
    *)
        if remote "$r"; then
            if is_current "$R_DIGEST" "$cur"; then
                rm -f "$STATE/available.json"
                act_done; status; last "$mode" true up_to_date "already up to date"; return 0
            fi
            if [ "$mode" = auto ] && is_held "$R_DIGEST"; then
                act_done; status; last auto true held "skipped the held-back version" "$R_VERSION"; return 0
            fi
        elif [ "$mode" = auto ]; then
            act_done; status; last auto false check "$R_ERR"; return 1
        fi
        if ! pull "$r" "$R_SIZE" "$mode" "$R_VERSION"; then
            act_done; status; last "$mode" false download "$PULL_OUT" "$R_VERSION"; return 1
        fi
        new=$(image_id "$r") ;;
    esac
    if [ -z "$new" ] || [ "$new" = "$cur" ]; then
        rm -f "$STATE/available.json"
        act_done; status; last "$mode" true up_to_date "already up to date"; return 0
    fi
    to=$(label "$new" org.opencontainers.image.version)
    datastore_blocked "$mode" && { act_done; status; return 1; }
    # This update's snapshot, named in the marker: a cut-off update undoes with this one or none.
    snap=$(snapshot_name "$cur")
    mark "$mode" "$cur" "$new" "$from" "$to" "$snap"
    # The datastore as the running image left it (stops Melissa for the copy; the restart starts her).
    if ! snapshot "$mode" "$cur" "$from" "$new" "$snap"; then
        # The name points at the new image since the pull: back to the one that ran, then start.
        podman tag "$cur" "$r"
        systemctl start "$UNIT"
        wait_up "$cur" "$mode" "$to" || true
        unmark; act_done; status
        last "$mode" false snapshot "not updated: $SNAP_ERR" "$to"
        return 1
    fi
    echo "melissa-host-update: restarting Melissa on ${new:0:12} (was ${cur:0:12})"
    restart_unit "$mode" restart "$to"
    if wait_up "$new" "$mode" "$to"; then
        update_done "$mode" "$cur" "$new" "$from" "$to" "$snap"
        return 0
    fi
    update_undo "$mode" "$cur" "$new" "$from" "$to" "$r" \
        "Melissa did not answer within $((START_WAIT / 60)) minutes after the restart" "$snap"
    return 1
}

apply() { update apply; }
auto() {
    if [ "$AUTO_UPDATE" = off ]; then echo "melissa-host-update: automatic updates are off"; return 0; fi
    update auto
}

rollback() {
    local r cur prev to from snap='' id name rc=0
    lock -w 3600 || { last rollback false busy "another update is running"; return 1; }
    datastore_blocked rollback && { status; return 1; }
    r=$(ref); cur=$(running_id || true)
    prev=$(image_id "$PREVIOUS" || true)
    if [ -z "$prev" ] || [ "$prev" = "$cur" ]; then
        status; last rollback false no_previous "there is no previous image"; return 1
    fi
    to=$(label "$prev" org.opencontainers.image.version)
    from=$(label "$cur" org.opencontainers.image.version)
    # The snapshot the update from the previous image took (update_done recorded it).
    if [ -r "$STATE/rollback-snapshot" ]; then
        read -r id name < "$STATE/rollback-snapshot"
        [ "$id" = "$prev" ] && snap=$name
    fi
    act rollback restart "$to"
    mark rollback "$cur" "$prev" "$from" "$to"
    [ -n "$cur" ] && hold "$cur" rolled_back
    podman tag "$prev" "$r"
    RESTORED=
    if [ -n "$cur" ]; then restore_if_needed rollback "$snap" "$prev" "$cur" "$to" || rc=$?; fi
    if [ "$rc" = 2 ]; then
        datastore_broken rollback "rolling back to ${prev:0:12}$RESTORED" "$to"
        return 1
    fi
    restart_unit rollback restart "$to"
    if wait_up "$prev" rollback "$to"; then
        rollback_done "$cur" "$prev" "$from" "$to"
    elif [ -n "$cur" ]; then
        rollback_undo "$cur" "$prev" "$from" "$to" "$r"; return 1
    else
        unmark; act_done; status; last rollback false no_start "the previous image did not start" "$to"; return 1
    fi
}

# --- Schedule -------------------------------------------------------------------------------------

valid_schedule() { [[ $1 =~ ^(daily|mon|tue|wed|thu|fri|sat|sun)-([01][0-9]|2[0-3])$ ]]; }
on_calendar() { # daily-03 -> "*-*-* 03:00:00", sun-03 -> "Sun *-*-* 03:00:00"
    local d=${1%-*} h=${1#*-}
    if [ "$d" = daily ]; then echo "*-*-* $h:00:00"; else echo "${d^} *-*-* $h:00:00"; fi
}

set_env() { # set_env KEY VALUE in install.env (a token without quotes or spaces)
    local f=$ENV_FILE keep
    [ -e "$f" ] || : > "$f"
    keep=$(grep -vc "^$1=" "$f")
    # Replace the file only when the new one is whole (a full disk must not truncate it).
    if { grep -v "^$1=" "$f"; echo "$1=$2"; } > "$f.new" 2>/dev/null \
        && [ "$(grep -vc "^$1=" "$f.new")" = "$keep" ] && grep -qx "$1=$2" "$f.new"; then
        mv -f "$f.new" "$f"
    else
        rm -f "$f.new"; echo "melissa-host-update: could not write $f" >&2; return 1
    fi
}

# Write the drop-in with the owner's time and switch the automatic update on or off. The check
# timer runs whatever the setting (a check downloads nothing), so the page knows of updates.
timers() {
    mkdir -p "$(dirname "$DROPIN")"
    printf '# Written by melissa-host-update from SCHEDULE=%s (Settings → Updates).\n[Timer]\nOnCalendar=\nOnCalendar=%s\n' \
        "$SCHEDULE" "$(on_calendar "$SCHEDULE")" > "$DROPIN.new" && mv -f "$DROPIN.new" "$DROPIN"
    systemctl daemon-reload
    if [ "$AUTO_UPDATE" = off ]; then
        systemctl disable -q --now "$TIMER" 2>/dev/null || true
    else
        systemctl enable -q "$TIMER"
        # A restart takes the new time; with Persistent=false it does not run the update now.
        systemctl restart "$TIMER"
    fi
    systemctl enable -q --now "$CHECK_TIMER"
}

auto_mode() { # what AUTO_UPDATE is when on, for this image
    case "$(ref)" in localhost/*) echo local ;; *) echo registry ;; esac
}

# --- Requests from the server ---------------------------------------------------------------------

# Delete the datastore snapshots (a factory reset: they hold the old data and its Secrets key).
forget_snapshots() {
    lock -w 3600 || return 1
    rm -rf -- "$SNAPSHOTS" "$STATE/rollback-snapshot"
    echo "melissa-host-update: datastore snapshots deleted (factory reset)"
}

requests() {
    local verb todo=() seen=() f n setting=no
    [ -d "$REQUESTS" ] || return 0
    # One look at the directory: only these names are acted on and deleted, so a request made
    # meanwhile stays for the next run (the path unit starts it again).
    while IFS= read -r -d '' f; do seen+=("${f##*/}"); done \
        < <(find "$REQUESTS" -mindepth 1 -maxdepth 1 -print0)
    has() { local x; for x in "${seen[@]}"; do [ "$x" = "$1" ] && return 0; done; return 1; }
    for n in auto-off auto-on; do
        if has "$n"; then
            if [ "$n" = auto-on ]; then AUTO_UPDATE=$(auto_mode); else AUTO_UPDATE=off; fi
            setting=yes
        fi
    done
    for f in "${seen[@]}"; do
        case "$f" in schedule-*) ;; *) continue ;; esac
        n=${f#schedule-}
        if valid_schedule "$n"; then SCHEDULE=$n; setting=yes; fi
    done
    # forget-snapshots: a factory reset inside removed the datastore these copies are of.
    if has forget-snapshots; then todo+=(forget_snapshots); fi
    for verb in check apply rollback; do
        if has "$verb"; then todo+=("$verb"); fi
    done
    # Delete what was seen: known names were noted, anything else is ignored. rm never follows links.
    for f in "${seen[@]}"; do rm -rf -- "${REQUESTS:?}/$f"; done
    if [ "$setting" = yes ]; then
        set_env AUTO_UPDATE "$AUTO_UPDATE" && set_env SCHEDULE "$SCHEDULE"
        timers
        status
        echo "melissa-host-update: automatic updates $AUTO_UPDATE, schedule $SCHEDULE"
    fi
    for verb in "${todo[@]}"; do "$verb"; done
}

[ "${BASH_SOURCE[0]}" = "$0" ] || return 0

load_env
mkdir -p "$STATUS"
helper_file 2>/dev/null || true
case "${1:-}" in
status) status; if [ "$(id -u)" = 0 ]; then resume_later; fi ;;
check|requests)
    [ "$(id -u)" = 0 ] || { echo "melissa-host-update: run as root" >&2; exit 1; }
    # A cut-off update first (it needs the lock the action would take).
    cut_off && resume
    "$1" ;;
apply|auto|rollback|timers|resume|resume-later)
    [ "$(id -u)" = 0 ] || { echo "melissa-host-update: run as root" >&2; exit 1; }
    "${1//-/_}" ;;
*) sed -n '2,39p' "$0"; exit 2 ;;
esac
