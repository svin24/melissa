# Sign one agent CLI in from Settings → Providers → Sign in. The polkit rule
# 51-melissa-agent-install.rules (container image only) lets the queen (user `melissa`) start only
# the instances `claude` and `grok`; melissa-setup checks the name again.
# - grok: a device code; the vendor's URL and code go to the log, nothing comes back.
# - claude: the vendor's URL goes to the log; the code the person pastes on the page comes back
#   through the FIFO /run/melissa-agent-install/claude-login.code (tmpfiles, root:melissa 0620),
#   never as an argument or log line. Exit status: 0 signed in, 3 code not accepted,
#   4 cancelled, 5 no code in time, 6 not signed in afterwards.
# Output goes to /run/melissa-agent-install/<name>-login.log (directory root:melissa 0750).
# The person signs in on their own device; Melissa never sees a password.
[Unit]
Description=Melissa: sign the %i agent CLI in
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/melissa-setup login %i --no-restart --from-page
Environment=TERM=dumb
StandardInput=null
StandardOutput=truncate:/run/melissa-agent-install/%i-login.log
StandardError=inherit
# Codes expire; don't wait for ever (melissa-setup gives up on Claude's code after 10 min).
TimeoutStartSec=15min
PrivateTmp=yes
