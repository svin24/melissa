# Install one agent CLI for the server's user (Settings → Providers → Install).
# The server (user `melissa`) may start only the instances claude, grok and opencode of this
# template (polkit rule 51-melissa-agent-install.rules); melissa-setup checks the name again. Output goes to
# /run/melissa-agent-install/<name>.log (root:melissa 0640), which the Providers page tails.
# Container image only (packaging/container/rootfs): on Nix installs the agent CLIs come from the Nix configuration.
[Unit]
Description=Melissa: install the %i agent CLI
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# No login (the page offers it) and no server restart (the server finds a new CLI by itself).
ExecStart=/usr/bin/melissa-setup agent %i --yes --no-login --no-restart
Environment=TERM=dumb
StandardInput=null
StandardOutput=truncate:/run/melissa-agent-install/%i.log
StandardError=inherit
TimeoutStartSec=15min
PrivateTmp=yes
