# Melissa: every minute, label newly joined devices' k3s nodes with their role
# (melissa-cluster-label.service). k3s.service wants it (30-cluster.conf); it runs only once the
# device has a cluster setting (the first invitation or join writes it and restarts k3s), so a
# single device never ticks.
[Unit]
Description=Melissa: label cluster nodes with their role (every minute)
ConditionPathExists=/etc/melissa/cluster.toml
RequiresMountsFor=/var/lib/melissa-container

[Timer]
OnActiveSec=1min
OnUnitInactiveSec=1min
AccuracySec=10s
