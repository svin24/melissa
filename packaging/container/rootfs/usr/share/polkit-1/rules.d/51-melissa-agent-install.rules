// Melissa, container image only: the queen (user `melissa`) may start the installer unit for the
// three known agent CLIs (Settings → Providers → Install) and the sign-in of Claude and Grok
// (Settings → Providers → Sign in). Nothing else: no other units, verbs, instances or arguments.
// The shared 50-melissa.rules (restart the queen) is separate; Nix installs ship only that one,
// since their agent CLIs come from the Nix configuration.
// See docs/DECISIONS.md (2026-11-19).
var MELISSA_AGENT_UNITS = [
    "melissa-agent-install@claude.service",
    "melissa-agent-install@grok.service",
    "melissa-agent-install@opencode.service",
    "melissa-agent-login@claude.service",
    "melissa-agent-login@grok.service",
];

polkit.addRule(function (action, subject) {
    if (action.id !== "org.freedesktop.systemd1.manage-units" || subject.user !== "melissa") {
        return polkit.Result.NOT_HANDLED;
    }
    if (action.lookup("verb") === "start" && MELISSA_AGENT_UNITS.indexOf(action.lookup("unit")) >= 0) {
        return polkit.Result.YES;
    }
    return polkit.Result.NOT_HANDLED;
});
