# Melissa as a container: systemd as PID 1 runs the server, k3s and the agent sandbox. Rootful podman,
# started by systemd through a Quadlet (packaging/container/melissa.container, install.sh).
# Docs: packaging/container/README.md, docs/agent-skills/container-image.md.
# Build (from the repo root): `just container-build`, or
#   podman build --network=host -f packaging/container/Containerfile -t localhost/melissa:dev .

ARG BASE=registry.fedoraproject.org/fedora:45
ARG BUILDER=registry.fedoraproject.org/fedora:45

# ---- stage 1: build the Melissa binaries --------------------------------------------
FROM ${BUILDER} AS build
RUN dnf -y install --setopt=install_weak_deps=False cargo rust gcc && dnf clean all
# cargo-about writes the third-party license report (about.toml, `just licenses`). Same version as the
# dev shell (devenv.nix); built once, then cached as this layer.
ARG CARGO_ABOUT_VERSION=0.9.0
RUN --mount=type=cache,target=/root/.cargo/registry \
    cargo install --locked --features cli --root /usr/local "cargo-about@${CARGO_ABOUT_VERSION}"
WORKDIR /src
# LICENSE and ACKNOWLEDGMENTS.md are built into the binary (Settings → About).
COPY Cargo.toml Cargo.lock clippy.toml about.toml about.hbs LICENSE ACKNOWLEDGMENTS.md ./
COPY crates ./crates
RUN --mount=type=cache,target=/root/.cargo/registry \
    --mount=type=cache,target=/src/target,id=melissa-target \
    # The target cache is shared between builds and cargo trusts file times: a build from an
    # older checkout (e.g. `git archive`, whose files carry the commit time) left artifacts newer
    # than these sources, and the image shipped stale crates. Touch ours so they always rebuild;
    # dependencies stay cached.
    # melissa-agent's only binary is melissa-netbridge (runs inside every agent sandbox).
    find crates -type f -exec touch {} + \
 && cargo build --release --locked -p melissa-server -p melissa-device -p melissa-agent \
 && install -D -m 0755 target/release/melissa-server target/release/melissa-device \
        target/release/melissa-netbridge -t /out/bin/ \
 && mkdir -p /out/licenses && cargo fetch --locked \
 && cargo about generate --workspace --frozen --fail -o /out/licenses/THIRD-PARTY-LICENSES.md about.hbs
# Melissa's own license (LICENSE, MIT) and the acknowledgments ship with the report.
COPY ACKNOWLEDGMENTS.md LICENSE* /out/licenses/

# ---- stage 2: fetch and verify k3s (versions and hashes pinned in k3s.lock) ----------
# No k3s-selinux: SELinux reads as disabled inside a container; the host confines the container.
FROM ${BUILDER} AS k3s
COPY packaging/common/usr/lib/melissa/k3s.lock /k3s.lock
RUN set -eu; . /k3s.lock; mkdir -p /out; cd /out; \
    tag=$(printf %s "$K3S_VERSION" | sed 's/+/%2B/'); \
    base="https://github.com/k3s-io/k3s/releases/download/$tag"; \
    curl -fsSL --retry 3 -o k3s "$base/k3s"; \
    curl -fsSL --retry 3 -o airgap.tar.zst "$base/k3s-airgap-images-amd64.tar.zst"; \
    curl -fsSL --retry 3 -o LICENSE "https://raw.githubusercontent.com/k3s-io/k3s/$tag/LICENSE"; \
    printf '%s  k3s\n%s  airgap.tar.zst\n%s  LICENSE\n' \
        "$K3S_SHA256" "$K3S_AIRGAP_SHA256" "$K3S_LICENSE_SHA256" | sha256sum -c -

# ---- stage 2b: fetch and verify Tailscale (version and hashes in tailscale.lock) ---------
# Melissa's own Tailscale (Settings → Tailscale, off by default): the official static binaries, so
# enabling it needs no download at run time and the image is the same on every install.
FROM ${BUILDER} AS tailscale
COPY packaging/container/tailscale.lock /tailscale.lock
RUN set -eu; . /tailscale.lock; mkdir -p /out /src; cd /src; \
    tgz="tailscale_${TAILSCALE_VERSION}_amd64.tgz"; \
    raw="https://raw.githubusercontent.com/tailscale/tailscale/v${TAILSCALE_VERSION}"; \
    curl -fsSL --retry 3 -o "$tgz" "https://pkgs.tailscale.com/stable/$tgz"; \
    curl -fsSL --retry 3 -o LICENSE "$raw/LICENSE"; \
    curl -fsSL --retry 3 -o THIRD-PARTY.md "$raw/licenses/tailscale.md"; \
    printf '%s  %s\n%s  LICENSE\n%s  THIRD-PARTY.md\n' "$TAILSCALE_SHA256" "$tgz" \
        "$TAILSCALE_LICENSE_SHA256" "$TAILSCALE_DEPS_LICENSES_SHA256" | sha256sum -c -; \
    tar xzf "$tgz" --strip-components=1; \
    install -m 0755 tailscale tailscaled /out/; \
    install -m 0644 LICENSE THIRD-PARTY.md /out/

# ---- stage 3: build whisper.cpp's CLI for voice input (version and hash in whisper.lock) ----
# A separate program, not linked into melissa-server: the server stays lean and C++-free, and a
# crash or the model's memory ends with each run. CPU only; GGML_CPU_ALL_VARIANTS builds the x86-64
# variants (SSE4.2 ... AVX-512) and the best one for the host's CPU is loaded at runtime, so the image
# runs on any x86-64 box. No SDL, ffmpeg, curl or server: Melissa sends it plain 16 kHz WAV files.
FROM ${BUILDER} AS whisper
RUN dnf -y install --setopt=install_weak_deps=False cmake gcc-c++ make && dnf clean all
COPY packaging/container/whisper.lock /whisper.lock
RUN set -eu; . /whisper.lock; mkdir -p /src /out; cd /src; \
    curl -fsSL --retry 3 -o whisper.tar.gz \
        "https://github.com/ggml-org/whisper.cpp/archive/refs/tags/v${WHISPER_VERSION}.tar.gz"; \
    printf '%s  whisper.tar.gz\n' "$WHISPER_SHA256" | sha256sum -c -; \
    tar xzf whisper.tar.gz --strip-components=1; \
    cmake -B build -DCMAKE_BUILD_TYPE=Release -DBUILD_SHARED_LIBS=ON \
        -DGGML_NATIVE=OFF -DGGML_BACKEND_DL=ON -DGGML_CPU_ALL_VARIANTS=ON -DGGML_OPENMP=OFF \
        -DWHISPER_BUILD_TESTS=OFF -DWHISPER_BUILD_SERVER=OFF -DWHISPER_SDL2=OFF \
        -DWHISPER_FFMPEG=OFF -DWHISPER_CURL=OFF \
        -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON -DCMAKE_INSTALL_RPATH='$ORIGIN'; \
    cmake --build build -j"$(nproc)"; \
    install -m 0755 build/bin/whisper-cli /out/; \
    find build \( -name 'libwhisper.so*' -o -name 'libggml.so*' -o -name 'libggml-base.so*' \
        -o -name 'libggml-cpu-*.so' \) -exec cp -P {} /out/ \; ; \
    install -D -m 0644 LICENSE /licenses/LICENSE; \
    /out/whisper-cli --help >/dev/null 2>&1

# ---- stage 4: the runtime image -------------------------------------------------------
FROM ${BASE}
# Only what Melissa needs inside (packaging/container/packages.txt). No kernel, bootloader, sshd,
# NetworkManager, chrony or firewalld: the host provides networking, time and access. Tailscale is
# the host's too, unless the owner enables Melissa's own (static binaries below, off by default).
COPY packaging/container/packages.txt /tmp/packages.txt
RUN pkgs=$(sed 's/#.*//' /tmp/packages.txt | xargs) \
 && dnf -y install --setopt=install_weak_deps=False $pkgs \
 && dnf clean all && rm -rf /tmp/packages.txt /run/dnf /var/cache/* /var/log/dnf* /var/lib/dnf

# k3s (rarely changes): binary + kubectl/crictl/ctr links, LICENSE, airgap images in /usr.
COPY --from=k3s /out/ /tmp/k3s/
COPY packaging/common/usr/lib/melissa/k3s.lock /usr/lib/melissa/k3s.lock
RUN set -eu; . /usr/lib/melissa/k3s.lock; \
    install -m 0755 /tmp/k3s/k3s /usr/bin/k3s; \
    for link in kubectl crictl ctr; do ln -sf k3s "/usr/bin/$link"; done; \
    install -D -m 0644 /tmp/k3s/LICENSE /usr/share/licenses/k3s/LICENSE; \
    install -D -m 0644 /tmp/k3s/airgap.tar.zst \
        "/usr/lib/melissa/k3s/images/k3s-airgap-images-${K3S_VERSION}-amd64.tar.zst"; \
    rm -rf /tmp/k3s

# Tailscale (rarely changes): Melissa's own, run by melissa-tailscaled.service only when enabled.
COPY --from=tailscale /out/tailscale /usr/bin/tailscale
COPY --from=tailscale /out/tailscaled /usr/sbin/tailscaled
COPY --from=tailscale /out/LICENSE /out/THIRD-PARTY.md /usr/share/licenses/tailscale/
COPY packaging/container/tailscale.lock /usr/lib/melissa/tailscale.lock

# whisper.cpp's CLI for voice input (rarely changes): found by melissa-server at this path.
COPY --from=whisper /out/ /usr/lib/melissa/whisper/
COPY --from=whisper /licenses/LICENSE /usr/share/licenses/whisper.cpp/LICENSE
COPY packaging/container/whisper.lock /usr/lib/melissa/whisper.lock

# Static config: the files every packaging shares, then the container's own (overrides and drop-ins).
COPY packaging/common/ /
COPY packaging/container/rootfs/ /
RUN rm -f /README.md
# No app images or app list ship: agents write app specs and containerd pulls the images when
# an app is deployed.
RUN set -eu; \
    systemctl enable melissa-server.service k3s.service melissa-kubeconfig.service \
        melissa-ui-forward.socket melissa-app-access.service melissa-tailscaled.service \
        melissa-factory-reset.path melissa-factory-reset.service; \
    # podman gives the container its network and DNS; nothing inside may take them over.
    systemctl mask systemd-resolved.service systemd-networkd.service systemd-networkd.socket \
        systemd-networkd-wait-online.service 2>/dev/null || true; \
    # Kernel filesystems a container may not mount (they would only mark the system degraded).
    systemctl mask sys-kernel-config.mount sys-kernel-debug.mount sys-kernel-tracing.mount \
        proc-sys-fs-binfmt_misc.automount systemd-firstboot.service console-getty.service \
        getty@tty1.service 2>/dev/null; \
    # Power is the host's business. The container is --privileged, so a logind inside would see the
    # host's lid switch and power keys and suspend the HOST with its own defaults (seen 2026-11-19 on
    # a laptop: lid closed on AC → host suspended, whatever the host's settings said).
    systemctl mask systemd-logind.service systemd-logind-varlink.socket \
        sleep.target suspend.target hibernate.target hybrid-sleep.target suspend-then-hibernate.target \
        systemd-suspend.service systemd-hibernate.service systemd-hybrid-sleep.service \
        systemd-suspend-then-hibernate.service 2>/dev/null; \
    # The container is recreated from the image at every start (Quadlet), and on updates; only /var is
    # a volume. Keep on it: k3s's node password (k3s refuses to rejoin its own datastore without it) and
    # the server's config (/etc/melissa: server.toml with [apps] addresses, Settings' providers.toml).
    mkdir -p /etc/rancher; rm -rf /etc/rancher/node /etc/melissa; \
    # Users and groups (melissa, melissa-kube) come from sysusers.d at start: systemd-sysusers only
    # runs when /etc is older than /usr (ConditionNeedsUpdate=/etc). A build step can leave a fresh
    # /etc/.updated (seen 2026-11-20: melissa-server failed with "Unknown user 'melissa'"), so drop it:
    # the container is new at every start anyway.
    rm -f /etc/.updated; \
    ln -s /var/lib/melissa-container/rancher-node /etc/rancher/node; \
    ln -s /var/lib/melissa-container/etc-melissa /etc/melissa

# Small, frequently changing layer last: binaries, their license report and version.
COPY --from=build /out/bin/ /usr/bin/
COPY --from=build /out/licenses/ /usr/share/licenses/melissa/
ARG MELISSA_VERSION=dev
ARG MELISSA_REVISION=
RUN printf 'MELISSA_VERSION=%s\nMELISSA_REVISION=%s\nMELISSA_RUNTIME=container\n' \
        "$MELISSA_VERSION" "$MELISSA_REVISION" > /usr/lib/melissa/release

# Image lint: what this image must and must not contain.
RUN set -eu; \
    for f in /usr/bin/melissa-server /usr/bin/melissa-device /usr/bin/melissa-netbridge /usr/bin/k3s \
        /usr/bin/bwrap /usr/sbin/nft /usr/sbin/iptables /usr/lib/systemd/systemd-socket-proxyd /usr/bin/melissa-setup \
        /usr/lib/melissa/whisper/whisper-cli /usr/bin/tailscale /usr/sbin/tailscaled \
        /usr/libexec/melissa/factory-reset; do \
        test -x "$f" || { echo "lint: missing $f"; exit 1; }; done; \
    . /usr/lib/melissa/tailscale.lock; \
    [ "$(/usr/bin/tailscale version | head -1)" = "$TAILSCALE_VERSION" ] \
        || { echo "lint: tailscale is not $TAILSCALE_VERSION"; exit 1; }; \
    test -s /usr/share/licenses/tailscale/LICENSE || { echo "lint: tailscale's license missing"; exit 1; }; \
    /usr/lib/melissa/whisper/whisper-cli --help >/dev/null 2>&1 || { echo "lint: whisper-cli doesn't run"; exit 1; }; \
    # npm-only agent CLIs (Gemini CLI, Pi) run on the image's Node; their packages need >= 20.6.
    node -e 'process.exit(+process.versions.node.split(".")[0] >= 22 ? 0 : 1)' || { echo "lint: node >= 22 missing"; exit 1; }; \
    npm --version >/dev/null || { echo "lint: npm missing"; exit 1; }; \
    # The tailscale package (its own tailscaled.service, enabled) must not come in: only the
    # pinned binaries, run by melissa-tailscaled.service while the owner has it on.
    for p in kernel-core bootc sshd openssh-server NetworkManager tailscale chrony firewalld; do \
        if rpm -q "$p" >/dev/null 2>&1; then echo "lint: $p must not be in the container"; exit 1; fi; done; \
    systemctl is-enabled -q melissa-server.service k3s.service melissa-ui-forward.socket \
        melissa-app-access.service melissa-tailscaled.service melissa-factory-reset.path \
        melissa-factory-reset.service; \
    test ! -e /usr/lib/systemd/system/tailscaled.service || { echo "lint: tailscaled.service must not exist"; exit 1; }; \
    for u in systemd-logind.service sleep.target suspend.target hibernate.target; do \
        [ "$(systemctl is-enabled "$u" 2>/dev/null)" = masked ] || { echo "lint: $u must be masked"; exit 1; }; done; \
    systemd-analyze verify --man=no /usr/lib/systemd/system/melissa-server.service \
        /usr/lib/systemd/system/k3s.service /usr/lib/systemd/system/melissa-ui-forward.socket \
        /usr/lib/systemd/system/melissa-app-access.service \
        /usr/lib/systemd/system/melissa-tailscaled.service \
        /usr/lib/systemd/system/melissa-factory-reset.path \
        /usr/lib/systemd/system/melissa-factory-reset.service; \
    grep -q '^MELISSA_VERSION=' /usr/lib/melissa/release; \
    # systemd-sysusers must run at every start (it creates the melissa user).
    test ! -e /etc/.updated || { echo "lint: /etc/.updated would skip systemd-sysusers"; exit 1; }

LABEL org.opencontainers.image.title="melissa" \
      org.opencontainers.image.version="${MELISSA_VERSION}" \
      org.opencontainers.image.revision="${MELISSA_REVISION}" \
      org.opencontainers.image.description="Melissa: server, k3s and agent sandbox under systemd (pre-alpha)" \
      org.opencontainers.image.licenses="MIT"
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
