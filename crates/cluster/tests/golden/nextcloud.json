{
  "namespace": {
    "apiVersion": "v1",
    "kind": "Namespace",
    "metadata": {
      "annotations": {
        "melissa.io/port": "30000",
        "melissa.io/shared-secrets": "admin_password",
        "melissa.io/spec": "{\"description\":\"Nextcloud: files, calendar and contacts (SQLite, for one to a few users).\",\"version\":\"34.0.6\",\"containers\":[{\"name\":\"nextcloud\",\"image\":\"docker.io/library/nextcloud:34.0.6-apache@sha256:3031e7f87baaceb863a755921ebf463bc26ea71855c07ad7858e2ae25a5a0ad7\",\"env\":{\"NEXTCLOUD_ADMIN_PASSWORD\":{\"secret\":\"admin_password\"},\"NEXTCLOUD_ADMIN_USER\":\"admin\",\"NEXTCLOUD_TRUSTED_DOMAINS\":{\"builtin\":\"device_hosts\"},\"PHP_MEMORY_LIMIT\":\"512M\",\"PHP_UPLOAD_LIMIT\":\"512M\",\"SQLITE_DATABASE\":\"nextcloud\"},\"ports\":[{\"name\":\"http\",\"port\":80}],\"mounts\":[{\"volume\":\"data\",\"path\":\"/var/www/html\"}],\"files\":[{\"path\":\"/docker-entrypoint-hooks.d/before-starting/50-melissa-trusted-domains.sh\",\"content\":\"#!/bin/sh\\n# Melissa: make Nextcloud's trusted_domains exactly the hosts in NEXTCLOUD_TRUSTED_DOMAINS\\n# (the image itself reads it only at the first install). Never fails the start: a problem\\n# here only means the app answers at fewer addresses.\\nset -u\\n[ -n \\\"${NEXTCLOUD_TRUSTED_DOMAINS:-}\\\" ] || exit 0\\ncd /var/www/html\\nphp occ status --output=json 2>/dev/null | grep -q '\\\"installed\\\":true' || exit 0\\nset -f\\ni=0\\nfor host in $NEXTCLOUD_TRUSTED_DOMAINS; do\\n    php occ config:system:set trusted_domains \\\"$i\\\" --value=\\\"$host\\\" >/dev/null\\n    i=$((i + 1))\\ndone\\nwhile php occ config:system:get trusted_domains \\\"$i\\\" >/dev/null 2>&1; do\\n    php occ config:system:delete trusted_domains \\\"$i\\\" >/dev/null\\n    i=$((i + 1))\\ndone\\necho \\\"Melissa: trusted_domains set to: $NEXTCLOUD_TRUSTED_DOMAINS\\\"\\n\",\"executable\":true}],\"resources\":{\"cpu\":\"1\",\"memory\":\"1Gi\",\"cpu_request\":\"100m\",\"memory_request\":\"256Mi\"},\"probe\":{\"port\":\"http\",\"path\":\"/status.php\",\"host_header\":true,\"startup_timeout_secs\":900,\"period_secs\":10}}],\"volumes\":[{\"name\":\"data\",\"size\":\"10Gi\"}],\"secrets\":[{\"name\":\"admin_password\",\"length\":32}],\"web\":\"http\",\"credentials\":{\"user\":\"admin\",\"password\":\"admin_password\"}}"
      },
      "labels": {
        "app.kubernetes.io/managed-by": "melissa",
        "melissa.io/app": "nextcloud",
        "melissa.io/managed": "true",
        "pod-security.kubernetes.io/enforce": "baseline",
        "pod-security.kubernetes.io/enforce-version": "latest"
      },
      "name": "app-nextcloud"
    }
  },
  "role_binding": {
    "apiVersion": "rbac.authorization.k8s.io/v1",
    "kind": "RoleBinding",
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "melissa",
        "app.kubernetes.io/name": "nextcloud",
        "app.kubernetes.io/version": "34.0.6",
        "melissa.io/app": "nextcloud"
      },
      "name": "melissa-apps",
      "namespace": "app-nextcloud"
    },
    "roleRef": {
      "apiGroup": "rbac.authorization.k8s.io",
      "kind": "ClusterRole",
      "name": "melissa-app-workload"
    },
    "subjects": [
      {
        "kind": "ServiceAccount",
        "name": "melissa-apps",
        "namespace": "melissa"
      }
    ]
  },
  "secrets": [
    {
      "namespace": "app-nextcloud",
      "name": "nextcloud-secrets",
      "key": "admin_password",
      "length": 32,
      "labels": {
        "app.kubernetes.io/managed-by": "melissa",
        "app.kubernetes.io/name": "nextcloud",
        "app.kubernetes.io/version": "34.0.6",
        "melissa.io/app": "nextcloud"
      }
    }
  ],
  "volumes": [
    {
      "apiVersion": "v1",
      "kind": "PersistentVolumeClaim",
      "metadata": {
        "labels": {
          "app.kubernetes.io/managed-by": "melissa",
          "app.kubernetes.io/name": "nextcloud",
          "app.kubernetes.io/version": "34.0.6",
          "melissa.io/app": "nextcloud"
        },
        "name": "nextcloud-data",
        "namespace": "app-nextcloud"
      },
      "spec": {
        "accessModes": [
          "ReadWriteOnce"
        ],
        "resources": {
          "requests": {
            "storage": "10Gi"
          }
        },
        "storageClassName": "local-path"
      }
    }
  ],
  "deployment": {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "melissa",
        "app.kubernetes.io/name": "nextcloud",
        "app.kubernetes.io/version": "34.0.6",
        "melissa.io/app": "nextcloud"
      },
      "name": "nextcloud",
      "namespace": "app-nextcloud"
    },
    "spec": {
      "replicas": 1,
      "revisionHistoryLimit": 3,
      "selector": {
        "matchLabels": {
          "melissa.io/app": "nextcloud"
        }
      },
      "strategy": {
        "type": "Recreate"
      },
      "template": {
        "metadata": {
          "annotations": {
            "melissa.io/files-sha256": "3cc528c204f35a34aec5a1f1bf808a942e074ac03bdac24367683f02d6945d28"
          },
          "labels": {
            "app.kubernetes.io/managed-by": "melissa",
            "app.kubernetes.io/name": "nextcloud",
            "app.kubernetes.io/version": "34.0.6",
            "melissa.io/app": "nextcloud"
          }
        },
        "spec": {
          "automountServiceAccountToken": false,
          "containers": [
            {
              "env": [
                {
                  "name": "NEXTCLOUD_ADMIN_PASSWORD",
                  "valueFrom": {
                    "secretKeyRef": {
                      "key": "admin_password",
                      "name": "nextcloud-secrets",
                      "optional": false
                    }
                  }
                },
                {
                  "name": "NEXTCLOUD_ADMIN_USER",
                  "value": "admin"
                },
                {
                  "name": "NEXTCLOUD_TRUSTED_DOMAINS",
                  "value": "nextcloud.melissa.home.arpa 192.0.2.15 melissa"
                },
                {
                  "name": "PHP_MEMORY_LIMIT",
                  "value": "512M"
                },
                {
                  "name": "PHP_UPLOAD_LIMIT",
                  "value": "512M"
                },
                {
                  "name": "SQLITE_DATABASE",
                  "value": "nextcloud"
                }
              ],
              "image": "docker.io/library/nextcloud:34.0.6-apache@sha256:3031e7f87baaceb863a755921ebf463bc26ea71855c07ad7858e2ae25a5a0ad7",
              "imagePullPolicy": "IfNotPresent",
              "livenessProbe": {
                "failureThreshold": 4,
                "httpGet": {
                  "httpHeaders": [
                    {
                      "name": "Host",
                      "value": "nextcloud.melissa.home.arpa"
                    }
                  ],
                  "path": "/status.php",
                  "port": "http"
                },
                "periodSeconds": 30,
                "timeoutSeconds": 10
              },
              "name": "nextcloud",
              "ports": [
                {
                  "containerPort": 80,
                  "name": "http",
                  "protocol": "TCP"
                }
              ],
              "readinessProbe": {
                "failureThreshold": 3,
                "httpGet": {
                  "httpHeaders": [
                    {
                      "name": "Host",
                      "value": "nextcloud.melissa.home.arpa"
                    }
                  ],
                  "path": "/status.php",
                  "port": "http"
                },
                "periodSeconds": 10,
                "timeoutSeconds": 5
              },
              "resources": {
                "limits": {
                  "cpu": "1",
                  "memory": "1Gi"
                },
                "requests": {
                  "cpu": "100m",
                  "memory": "256Mi"
                }
              },
              "securityContext": {
                "allowPrivilegeEscalation": false,
                "privileged": false
              },
              "startupProbe": {
                "failureThreshold": 90,
                "httpGet": {
                  "httpHeaders": [
                    {
                      "name": "Host",
                      "value": "nextcloud.melissa.home.arpa"
                    }
                  ],
                  "path": "/status.php",
                  "port": "http"
                },
                "periodSeconds": 10,
                "timeoutSeconds": 5
              },
              "volumeMounts": [
                {
                  "mountPath": "/var/www/html",
                  "name": "data"
                },
                {
                  "mountPath": "/docker-entrypoint-hooks.d/before-starting/50-melissa-trusted-domains.sh",
                  "name": "melissa-files",
                  "readOnly": true,
                  "subPath": "nextcloud.0"
                }
              ]
            }
          ],
          "enableServiceLinks": false,
          "securityContext": {
            "seccompProfile": {
              "type": "RuntimeDefault"
            }
          },
          "volumes": [
            {
              "name": "data",
              "persistentVolumeClaim": {
                "claimName": "nextcloud-data"
              }
            },
            {
              "configMap": {
                "defaultMode": 292,
                "items": [
                  {
                    "key": "nextcloud.0",
                    "mode": 365,
                    "path": "nextcloud.0"
                  }
                ],
                "name": "nextcloud-files",
                "optional": false
              },
              "name": "melissa-files"
            }
          ]
        }
      }
    }
  },
  "service": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "melissa",
        "app.kubernetes.io/name": "nextcloud",
        "app.kubernetes.io/version": "34.0.6",
        "melissa.io/app": "nextcloud"
      },
      "name": "nextcloud",
      "namespace": "app-nextcloud"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "port": 80,
          "protocol": "TCP",
          "targetPort": "http"
        }
      ],
      "selector": {
        "melissa.io/app": "nextcloud"
      },
      "type": "ClusterIP"
    }
  },
  "files": {
    "apiVersion": "v1",
    "kind": "ConfigMap",
    "data": {
      "nextcloud.0": "#!/bin/sh\n# Melissa: make Nextcloud's trusted_domains exactly the hosts in NEXTCLOUD_TRUSTED_DOMAINS\n# (the image itself reads it only at the first install). Never fails the start: a problem\n# here only means the app answers at fewer addresses.\nset -u\n[ -n \"${NEXTCLOUD_TRUSTED_DOMAINS:-}\" ] || exit 0\ncd /var/www/html\nphp occ status --output=json 2>/dev/null | grep -q '\"installed\":true' || exit 0\nset -f\ni=0\nfor host in $NEXTCLOUD_TRUSTED_DOMAINS; do\n    php occ config:system:set trusted_domains \"$i\" --value=\"$host\" >/dev/null\n    i=$((i + 1))\ndone\nwhile php occ config:system:get trusted_domains \"$i\" >/dev/null 2>&1; do\n    php occ config:system:delete trusted_domains \"$i\" >/dev/null\n    i=$((i + 1))\ndone\necho \"Melissa: trusted_domains set to: $NEXTCLOUD_TRUSTED_DOMAINS\"\n"
    },
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "melissa",
        "app.kubernetes.io/name": "nextcloud",
        "app.kubernetes.io/version": "34.0.6",
        "melissa.io/app": "nextcloud"
      },
      "name": "nextcloud-files",
      "namespace": "app-nextcloud"
    }
  },
  "port_service": {
    "apiVersion": "v1",
    "kind": "Service",
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "melissa",
        "app.kubernetes.io/name": "nextcloud",
        "app.kubernetes.io/version": "34.0.6",
        "melissa.io/app": "nextcloud"
      },
      "name": "nextcloud-port",
      "namespace": "app-nextcloud"
    },
    "spec": {
      "ports": [
        {
          "name": "http",
          "nodePort": 30000,
          "port": 80,
          "protocol": "TCP",
          "targetPort": "http"
        }
      ],
      "selector": {
        "melissa.io/app": "nextcloud"
      },
      "type": "NodePort"
    }
  },
  "ingress": {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "Ingress",
    "metadata": {
      "labels": {
        "app.kubernetes.io/managed-by": "melissa",
        "app.kubernetes.io/name": "nextcloud",
        "app.kubernetes.io/version": "34.0.6",
        "melissa.io/app": "nextcloud"
      },
      "name": "nextcloud",
      "namespace": "app-nextcloud"
    },
    "spec": {
      "ingressClassName": "traefik",
      "rules": [
        {
          "host": "nextcloud.melissa.home.arpa",
          "http": {
            "paths": [
              {
                "backend": {
                  "service": {
                    "name": "nextcloud",
                    "port": {
                      "name": "http"
                    }
                  }
                },
                "path": "/",
                "pathType": "Prefix"
              }
            ]
          }
        }
      ]
    }
  }
}
