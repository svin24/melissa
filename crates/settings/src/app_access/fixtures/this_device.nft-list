table inet melissa_app_access {
	chain prerouting {
		type filter hook prerouting priority mangle; policy accept;
		iifname != { "lo", "cni0" } tcp dport 30000-30079 jump app_ports
		iifname != { "lo", "cni0" } udp dport 30000-30079 jump app_ports
	}

	chain input {
		type filter hook input priority mangle; policy accept;
		iifname "tailscale0" ct state established,related accept comment "melissa:tailnet_replies"
		iifname "tailscale0" counter packets 0 bytes 0 drop comment "melissa:tailnet_input"
	}

	chain app_ports {
		iifname != "tailscale0" ip saddr 10.88.0.1 accept comment "melissa:this_device"
		counter packets 0 bytes 0 drop comment "melissa:drop"
	}
}
