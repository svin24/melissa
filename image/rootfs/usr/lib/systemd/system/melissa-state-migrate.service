[Unit]
Description=Melissa: move the queen's state out of the old DynamicUser layout
Documentation=file:///usr/libexec/melissa/melissa-state-migrate
ConditionPathIsSymbolicLink=/var/lib/melissa
After=systemd-sysusers.service systemd-tmpfiles-setup.service
Before=melissa-queen.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/melissa/melissa-state-migrate
