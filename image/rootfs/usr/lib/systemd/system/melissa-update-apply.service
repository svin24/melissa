[Unit]
Description=Melissa: download and apply a newer OS image, then reboot
Documentation=file:///usr/libexec/melissa/melissa-update
ConditionPathExists=/run/ostree-booted
After=network-online.target
Wants=network-online.target
# Started by the queen (user melissa) via polkit (50-melissa.rules); one fixed verb, no input.
# Two at once would race on bootc; systemd runs one job per unit, bootc locks the sysroot.

[Service]
Type=oneshot
ExecStart=/usr/libexec/melissa/melissa-update apply
TimeoutStartSec=1h
