[Unit]
Description=Melissa queen's k3s credentials (read-only ServiceAccount kubeconfig)
Documentation=file:///usr/lib/melissa/k3s/manifests/queen-rbac.yaml
After=k3s.service
ConditionPathExists=/usr/bin/k3s

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/libexec/melissa/melissa-kubeconfig
# The script waits up to 300 s for the API and the token on first boot; if k3s is slower than
# that, try again. Nothing waits for this unit (the queen picks the file up when it appears).
TimeoutStartSec=330
Restart=on-failure
RestartSec=15s

[Install]
# Enabled in both images: starts whenever k3s does.
WantedBy=k3s.service
