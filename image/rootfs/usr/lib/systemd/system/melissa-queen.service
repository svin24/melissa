[Unit]
Description=Melissa queen bee (system)
After=network-online.target
Wants=network-online.target melissa-state-migrate.service
# One-time move from the old DynamicUser state layout (skipped once done).
After=melissa-state-migrate.service
# Deliberately not ordered after k3s or melissa-kubeconfig.service: the web UI and agents start
# at once. The queen reads /run/melissa-kube/queen.kubeconfig on each cluster call, so it attaches
# to k3s when the credentials appear (and follows rotations) without a restart.

[Service]
# A fixed system user (sysusers.d/melissa.conf), not DynamicUser: the agent CLIs and their
# logins live in its home, /var/lib/melissa/home, set up with `sudo melissa-setup agent <name>`.
# Each agent still runs in its own bubblewrap sandbox with only its own credential file.
User=melissa
Group=melissa
StateDirectory=melissa
StateDirectoryMode=0750
ConfigurationDirectory=melissa
# Owned by melissa via tmpfiles.d/melissa-config.conf (Settings writes providers.toml here).
ConfigurationDirectoryMode=0750
# Per-sandbox egress sockets (crates/agent/src/egress) live in /run/melissa/egress.
RuntimeDirectory=melissa
RuntimeDirectoryMode=0700
# Maps the XDG paths used by the queen to /etc/melissa, /var/lib/melissa and /run/melissa.
Environment=XDG_CONFIG_HOME=/etc XDG_STATE_HOME=/var/lib XDG_RUNTIME_DIR=/run
# Where the vendors' installers put the agent CLIs (found on PATH as claude, grok, opencode).
Environment=HOME=/var/lib/melissa/home
Environment=PATH=/var/lib/melissa/home/.local/bin:/var/lib/melissa/home/.grok/bin:/var/lib/melissa/home/.opencode/bin:/usr/bin
# Read access to the read-only k3s kubeconfig (root:melissa-kube 0640 in /run/melissa-kube).
SupplementaryGroups=melissa-kube
ExecStart=/usr/bin/melissa-queen
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
