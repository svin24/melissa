[Unit]
Description=Melissa queen bee (system)
After=network-online.target
Wants=network-online.target
# Deliberately not ordered after k3s or melissa-kubeconfig.service: the web UI and agents start
# at once. The queen reads /run/melissa-kube/queen.kubeconfig on each cluster call, so it attaches
# to k3s when the credentials appear (and follows rotations) without a restart.

[Service]
DynamicUser=yes
StateDirectory=melissa
ConfigurationDirectory=melissa
# Maps the XDG paths used by the queen to /etc/melissa and /var/lib/melissa.
Environment=XDG_CONFIG_HOME=/etc XDG_STATE_HOME=/var/lib
# Read access to the read-only k3s kubeconfig (root:melissa-kube 0640 in /run/melissa-kube).
SupplementaryGroups=melissa-kube
ExecStart=/usr/bin/melissa-queen
Restart=on-failure
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
