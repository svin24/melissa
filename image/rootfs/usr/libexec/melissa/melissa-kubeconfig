#!/bin/sh
# Writes the queen's two kubeconfigs to /run/melissa-kube (tmpfs, gone at reboot),
# root:melissa-kube 0640. Only melissa-queen.service (DynamicUser) carries
# SupplementaryGroups=melissa-kube. Runs as root after k3s (melissa-kubeconfig.service).
#
#   queen.kubeconfig  ServiceAccount melissa/melissa-queen, read-only (queen-rbac.yaml)
#   apps.kubeconfig   ServiceAccount melissa/melissa-apps, app installs only (apps-rbac.yaml)
#
# The queen re-reads the files on each cluster call, so neither a late first boot nor a
# rotation needs a queen restart.
#
#   melissa-kubeconfig                  wait for the tokens and (re)write both kubeconfigs
#   melissa-kubeconfig rotate [queen|apps]
#                                       replace a token (default: both; the old one stops
#                                       working) and rewrite
#
# Rotation recreates the ServiceAccount, not just the Secret: a Secret-based token has no iat/exp
# claims and RS256 signatures are deterministic, so a new Secret with the same name gets a
# byte-identical token (verified 2026-11-18). A new ServiceAccount UID changes the token and
# invalidates the old one.
set -eu
ns=melissa
store=/run/melissa-kube
manifests=/usr/lib/melissa/k3s/manifests
kc() { k3s kubectl "$@"; }

mode=${1:-}
which=${2:-all}
case "$mode" in
    ''|rotate) ;;
    *) echo "usage: melissa-kubeconfig [rotate [queen|apps]]" >&2; exit 2 ;;
esac
case "$which" in
    all|queen|apps) ;;
    *) echo "usage: melissa-kubeconfig [rotate [queen|apps]]" >&2; exit 2 ;;
esac

# Recreate what's missing; k3s's deploy controller owns the rest, so skip existing objects.
recreate() { kc create -f "$1" 2>&1 | grep -v AlreadyExists || true; }

# write <id> <service account> <manifest> <file>
write() {
    id=$1 sa=$2 manifest=$3 out=$store/$4
    secret=$sa-token
    rotating=no
    if [ "$mode" = rotate ] && { [ "$which" = all ] || [ "$which" = "$id" ]; }; then
        rotating=yes
        kc -n "$ns" delete secret "$secret" --ignore-not-found
        kc -n "$ns" delete serviceaccount "$sa" --ignore-not-found
        recreate "$manifest"
    fi
    # On first boot the API, the manifests and the token controller all take a while.
    end=$(( $(date +%s) + ${MELISSA_KUBECONFIG_WAIT:-300} ))
    until token=$(kc -n "$ns" get secret "$secret" -o 'jsonpath={.data.token}' 2>/dev/null) && [ -n "$token" ]; do
        [ "$(date +%s)" -lt "$end" ] || { echo "timed out waiting for the token in $ns/$secret" >&2; return 1; }
        sleep 3
        # The token controller may still be cleaning up after the old ServiceAccount and delete
        # the fresh Secret; put it back.
        if [ "$rotating" = yes ] && ! kc -n "$ns" get secret "$secret" >/dev/null 2>&1; then recreate "$manifest"; fi
    done
    ca=$(kc -n "$ns" get secret "$secret" -o 'jsonpath={.data.ca\.crt}')
    [ -n "$ca" ] || { echo "no ca.crt in $ns/$secret" >&2; return 1; }
    token=$(printf %s "$token" | base64 -d)

    umask 077
    install -d -m 0750 -g melissa-kube "$store"
    tmp=$(mktemp "$store/.$4.XXXXXX")
    trap 'rm -f "$tmp"' EXIT
    cat > "$tmp" <<KUBECONFIG
apiVersion: v1
kind: Config
clusters:
  - name: local
    cluster:
      server: https://127.0.0.1:6443
      certificate-authority-data: $ca
users:
  - name: $sa
    user:
      token: $token
contexts:
  - name: local
    context: {cluster: local, user: $sa, namespace: $ns}
current-context: local
KUBECONFIG
    chgrp melissa-kube "$tmp"
    chmod 0640 "$tmp"
    mv -f "$tmp" "$out"
    trap - EXIT
    echo "wrote $out for $ns/$sa"
}

write queen melissa-queen "$manifests/queen-rbac.yaml" queen.kubeconfig
write apps melissa-apps "$manifests/apps-rbac.yaml" apps.kubeconfig
