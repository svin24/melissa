#!/bin/sh
# Writes the queen's kubeconfig (ServiceAccount melissa/melissa-queen, read-only RBAC from
# queen-rbac.yaml) to /run/melissa-kube/queen.kubeconfig, root:melissa-kube 0640 (tmpfs, gone at
# reboot). Only melissa-queen.service (DynamicUser) carries SupplementaryGroups=melissa-kube.
# The queen re-reads the file on each cluster call, so neither a late first boot nor a rotation
# needs a queen restart. Runs as root after k3s (melissa-kubeconfig.service).
#
#   melissa-kubeconfig          wait for the token and (re)write the kubeconfig
#   melissa-kubeconfig rotate   replace the token (the old one stops working) and rewrite
#
# Rotation recreates the ServiceAccount, not just the Secret: a Secret-based token has no iat/exp
# claims and RS256 signatures are deterministic, so a new Secret with the same name gets a
# byte-identical token (verified 2026-11-18). A new ServiceAccount UID changes the token and
# invalidates the old one.
set -eu
ns=melissa
secret=melissa-queen-token
store=/run/melissa-kube
out=$store/queen.kubeconfig
manifest=/usr/lib/melissa/k3s/manifests/queen-rbac.yaml
kc() { k3s kubectl "$@"; }

if [ "${1:-}" = rotate ]; then
    kc -n "$ns" delete secret "$secret" --ignore-not-found
    kc -n "$ns" delete serviceaccount melissa-queen --ignore-not-found
fi
# Recreate what's missing; k3s's deploy controller owns the rest, so skip existing objects.
recreate() { kc create -f "$manifest" 2>&1 | grep -v AlreadyExists || true; }
[ "${1:-}" = rotate ] && recreate

# On first boot the API, the manifest and the token controller all take a while.
end=$(( $(date +%s) + ${MELISSA_KUBECONFIG_WAIT:-300} ))
until token=$(kc -n "$ns" get secret "$secret" -o 'jsonpath={.data.token}' 2>/dev/null) && [ -n "$token" ]; do
    [ "$(date +%s)" -lt "$end" ] || { echo "timed out waiting for the token in $ns/$secret" >&2; exit 1; }
    sleep 3
    # The token controller may still be cleaning up after the old ServiceAccount and delete the
    # fresh Secret; put it back.
    if [ "${1:-}" = rotate ] && ! kc -n "$ns" get secret "$secret" >/dev/null 2>&1; then recreate; fi
done
ca=$(kc -n "$ns" get secret "$secret" -o 'jsonpath={.data.ca\.crt}')
[ -n "$ca" ] || { echo "no ca.crt in $ns/$secret" >&2; exit 1; }
token=$(printf %s "$token" | base64 -d)

umask 077
install -d -m 0750 -g melissa-kube "$store"
tmp=$(mktemp "$store/.queen.kubeconfig.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cat > "$tmp" <<KUBECONFIG
apiVersion: v1
kind: Config
clusters:
  - name: local
    cluster:
      server: https://127.0.0.1:6443
      certificate-authority-data: $ca
users:
  - name: melissa-queen
    user:
      token: $token
contexts:
  - name: local
    context: {cluster: local, user: melissa-queen, namespace: $ns}
current-context: local
KUBECONFIG
chgrp melissa-kube "$tmp"
chmod 0640 "$tmp"
mv -f "$tmp" "$out"
trap - EXIT
echo "wrote $out for $ns/melissa-queen"
