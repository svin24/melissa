<?xml version="1.0" encoding="utf-8"?>
<!-- Melissa (desktop image): each installed app gets its own port on the device from this range
     (a k3s NodePort; see docs/DECISIONS.md, 2026-11-19). Kinoite's default zone
     (FedoraWorkstation) already accepts TCP 1025-65535, so nothing needs enabling there. If you
     moved the LAN or tailscale0 interface to a stricter zone (e.g. public), open the apps with
     `sudo firewall-cmd --permanent --zone=<zone> --add-service=melissa-apps && sudo firewall-cmd --reload`. -->
<service>
  <short>Melissa apps</short>
  <description>Web ports of apps installed by Melissa (http://device:port).</description>
  <port protocol="tcp" port="30000-30079"/>
</service>
