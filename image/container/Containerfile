# Melissa in a container: the headless bootc image, unchanged, plus a thin layer for running it
# under podman with systemd as PID 1 (no kernel, no bootloader, no bootc). See
# docs/agent-skills/container-mode.md and scripts/container-run.sh.
# Build: `scripts/container-run.sh build` (needs localhost/melissa-headless:dev or IMAGE=...).
ARG IMAGE=localhost/melissa-headless:dev
FROM ${IMAGE}
COPY image/container/rootfs/ /
RUN set -eu; \
    # podman gives the container its network and DNS (pasta: 169.254.1.1 in /etc/resolv.conf).
    # NetworkManager and resolved inside would take over the interface and hide that resolver.
    systemctl mask NetworkManager.service NetworkManager-wait-online.service \
        systemd-resolved.service systemd-resolved-varlink.socket systemd-resolved-monitor.socket; \
    # Host jobs, not the container's: tailnet, SSH (use `podman exec`), clock, bootloader,
    # bootc updates (replace the container instead), console account prompt (no console).
    systemctl mask tailscaled.service sshd.service chronyd.service bootloader-update.service \
        bootc-fetch-apply-updates.timer melissa-firstboot.service; \
    # Kernel filesystems a container may not mount (they would only mark the system degraded).
    systemctl mask sys-kernel-config.mount sys-kernel-debug.mount sys-kernel-tracing.mount \
        proc-sys-fs-binfmt_misc.automount var-lib-nfs-rpc_pipefs.mount; \
    # /etc is reset when the container is recreated from a new image; only /var is a volume.
    # k3s keeps the node password in /etc/rancher/node and refuses to rejoin its own datastore
    # without it, so keep it on the volume.
    rm -rf /etc/rancher/node; ln -s /var/lib/melissa-container/rancher-node /etc/rancher/node; \
    # The queen's config (/etc/melissa/queen.toml: [apps] addresses, backends) must survive a
    # recreate too; container-run.sh writes the container's app addresses there.
    rm -rf /etc/melissa; ln -s /var/lib/melissa-container/etc-melissa /etc/melissa; \
    echo 'MELISSA_RUNTIME=container' >> /usr/lib/melissa/release
